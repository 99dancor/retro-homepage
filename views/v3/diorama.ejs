<%- include('_head') %>
<%# Seite eines Spielstands (src/dioramen.js page()): Titelbild, „Springen zu“ und die Kacheln auf dem Raster.
    Bilder groß, Regler und Kartenpunkte: public/dioramen.js. Gestalten (Kacheln ziehen, Größe, Inhalt): public/dio-kacheln.js %>
<% const fmt = s => new Date(s * 1000).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
   const vno = v => String(v).replace(/^v/i, '');
   const mapTile = tiles.find(r => r.t.type === 'map' && !r.empty);
   const mapId = mapTile ? mapTile.t.id : null;
   const tileLocals = { types, anchors, mapId, buildings, d, edit: !!editData }; %>
<p class="crumbs"><a href="/dioramen">Dancors Dioramen</a><% if (d.game) { %> › <a href="/dioramen?spiel=<%= encodeURIComponent(d.game) %>"><%= d.game %></a><% } %> › <%= d.title %></p>
<% if (ok) { %><p class="v3-flash" role="status"><%= ok %></p><% } %>

<% if (editData) { %>
<div class="edit-bar dio-bar" role="toolbar" aria-label="Gestalten" hidden>
  <b><span class="emo">✏️</span> Spielstand gestalten</b>
  <span class="hint">Am ⠿ verschieben, an den blauen Griffen Größe ändern, rechts neue Kacheln holen.</span>
  <span class="sp"></span>
  <span class="dio-state" aria-live="polite"></span>
  <button type="button" class="pill small" data-k="undo" disabled>↶ Rückgängig</button>
  <button type="button" class="pill small" data-k="cancel">Abbrechen</button>
  <button type="button" class="pill small pri" data-k="save">✔ Fertig</button>
</div>
<% } %>

<div class="dio-wrap">
<div class="dio-main">
<section class="di-hero<%= cover ? '' : ' plain' %>"<%= cover ? ' data-lb-hero' : '' %>>
  <% if (cover) { %><img src="/media/<%= cover %>" alt=""><% } %>
  <span class="flg">
    <% if (d.pinned) { %><span class="flag-b pin">📌 Angepinnt</span><% } %>
    <% if (fresh) { %><span class="flag-b new">🆕 Neu</span><% } %>
  </span>
  <div class="tx">
    <span class="kick">💾 Spielstand<% if (d.game) { %> · <%= d.game %><% } %><% if (d.world) { %> · <%= d.world %><% } %></span>
    <h1><%= d.title %></h1>
    <% if (d.summary) { %><p><%= d.summary %></p><% } %>
    <div class="row">
      <% if (buildings.length) { %><span class="tag">🏗️ <%= buildings.length %> <%= buildings.length === 1 ? 'Bauwerk' : 'Bauwerke' %></span><% } %>
      <span class="tag">Stand <%= fmt(Math.max(d.updated_at, latest ? latest.created_at : 0)) %></span>
      <% if (author) { %><span class="tag">von <%= author %></span><% } %>
      <% if (d.visibility !== 'public') { %><span class="tag">🔒 <%= ({ members: 'Mitglieder', friends: 'Freunde', groups: 'Gruppen', private: 'privat' })[d.visibility] %></span><% } %>
      <% if (latest) { %><a class="pill small pri" href="/dioramen/dl/<%= latest.id %>">⬇ Spielstand<%= latest.version ? ' ' + vno(latest.version) : '' %> laden</a><% } %>
      <% if (editData) { %><button type="button" class="pill small" data-k="start">✏️ Gestalten</button><a class="pill small" href="/dioramen/<%= d.slug %>/bearbeiten">⚙ Eckdaten und Dateien</a><% } %>
    </div>
  </div>
</section>

<% const jump = buildings.filter(b => b.anchor); %>
<% if (jump.length) { %>
<nav class="jump" aria-label="Bauwerke">Springen zu: <% for (const b of jump) { %><a href="#bw-<%= b.id %>" data-bw="<%= b.id %>" style="--bwc:<%= b.hex %>"><i><%= b.no %></i><%= b.name %></a><% } %></nav>
<% } %>

<div class="kg" id="kg">
<% for (const f of frames) { %><div class="bwframe" data-frame="<%= f.id %>" style="grid-column:<%= f.x %> / span <%= f.w %>;grid-row:<%= f.y %> / span <%= f.h %>;--bwc:<%= f.hex %>" aria-hidden="true"></div><% } %>
<% for (const r of tiles) { %><%- include('_dio-tile', { r, ...tileLocals }) %><% } %>
</div>
<% if (!tiles.length) { %><div class="list"><div class="empty-state"><span class="e emo">🧱</span>Hier steht noch nichts.<% if (editData) { %> Auf „Gestalten“ tippen und Kacheln hinzufügen.<% } %></div></div><% } %>
</div>

<% if (editData) { %>
<aside class="dio-pal" hidden>
  <section class="card"><h3 class="side-h">＋ Kachel hinzufügen</h3>
    <p class="muted small-note" style="margin:0 0 8px">Aufs Raster ziehen oder antippen (kommt dann unten dazu).</p>
    <div class="pal"><% for (const [k, T] of Object.entries(types)) { if (k === 'head') continue; %><button type="button" data-add="<%= k %>"><b class="emo"><%= T.icon %></b><%= T.label %></button><% } %></div>
  </section>
  <section class="card"><h3 class="side-h">🏗️ Bauwerke</h3>
    <div class="bwlist" id="dio-bws"></div>
    <button type="button" class="pill small" data-k="bw-add" style="margin-top:8px">＋ Neues Bauwerk</button>
    <p class="muted small-note">Oben an jeder Kachel wählst du, zu welchem Bauwerk sie gehört. Sie bekommt dann seine Farbe, und Kartenpunkte springen zu ihr.</p>
  </section>
</aside>
<% } %>
</div>

<div class="dio-toast" hidden role="status"><span class="dot"></span><span class="tx"></span><a class="pill small" href="#">↑ Zurück zur Karte</a></div>
<% if (editData) { %><script type="application/json" id="dio-data"><%- JSON.stringify({ slug: d.slug, ...editData }).replace(/</g, '\\u003c') %></script><% } %>
<script src="<%= asset('dioramen.js') %>" defer></script>
<% if (editData) { %><script src="<%= asset('dio-kacheln.js') %>" defer></script><% } %>
<%- include('_foot') %>
