<%- include('../partials/head') %>
<% if (ok) { %><div class="msg">✔ Gespeichert.</div><% } %>
<p><a href="/admin/files">⬅ Zurück zu den Dateien</a></p>
<form method="post" action="/admin/files/kategorien">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <fieldset class="groupbox"><legend>🏷️ Kategorien der Downloads</legend>
    <p class="muted"><small>Die Kategorien stehen links im Baum der Downloads und beim Hochladen zur Auswahl. An den Endungen erkennt das Hochladen, wohin eine Datei gehört (Musik und Videos gehen auf Wunsch in den Mediaplayer). Umbenennen nimmt die Dateien mit, Löschen legt sie unter „Allgemein“.</small></p>
    <table class="list">
      <tr><th>Symbol</th><th>Name</th><th>Endungen (für den Vorschlag)</th><th>Spiel</th><th class="num">Dateien</th><th>Löschen</th></tr>
      <% cats.forEach((c, i) => { %>
      <tr>
        <td><input type="text" name="icon" value="<%= c.icon %>" style="width:44px;text-align:center" aria-label="Symbol"></td>
        <td><input type="hidden" name="old" value="<%= c.name %>"><input type="text" name="name" value="<%= c.name %>" style="width:150px" aria-label="Name"<%= c.name === 'Allgemein' ? ' readonly' : '' %>>
          <% if (c.loose) { %><br><small class="muted">nur an alten Dateien</small><% } %></td>
        <td><input type="text" name="ext" value="<%= c.ext.join(' ') %>" style="width:100%;min-width:180px" placeholder="z. B. zip rar" aria-label="Endungen"></td>
        <td class="c"><input type="checkbox" name="game" value="<%= i %>"<%= c.game ? ' checked' : '' %> title="Beim Hochladen nach dem Spiel fragen"></td>
        <td class="num"><%= counts[c.name] || 0 %></td>
        <td class="c"><% if (c.name !== 'Allgemein') { %><input type="checkbox" name="del" value="<%= c.name %>" aria-label="<%= c.name %> löschen"><% } %></td>
      </tr>
      <% }) %>
      <tr>
        <td><input type="text" name="icon" value="📁" style="width:44px;text-align:center" aria-label="Symbol der neuen Kategorie"></td>
        <td><input type="hidden" name="old" value=""><input type="text" name="name" value="" style="width:150px" placeholder="➕ Neue Kategorie" aria-label="Neue Kategorie"></td>
        <td><input type="text" name="ext" value="" style="width:100%;min-width:180px" placeholder="z. B. sav" aria-label="Endungen der neuen Kategorie"></td>
        <td class="c"><input type="checkbox" name="game" value="<%= cats.length %>"></td><td></td><td></td>
      </tr>
    </table>
  </fieldset>
  <fieldset class="groupbox"><legend>⛔ Nicht erlaubt</legend>
    <label>Diese Endungen nehmen die Downloads von Mitgliedern nicht an (du selbst darfst alles hochladen):
      <textarea name="blocked" style="min-height:44px"><%= blocked %></textarea></label>
  </fieldset>
  <div class="actions"><button><b>Speichern</b></button></div>
</form>
<%- include('../partials/foot') %>
