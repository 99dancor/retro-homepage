<%- include('_top') %>
<%# Karte über das ganze Fenster: links die Ansichten wie im Spielmenü (◀ ▶ blättert, Linksklick blendet einen Eintrag aus, Rechtsklick zeigt nur ihn),
    rechts die Karte mit den echten Feldformen (sonst Kreisen), zoombar und verschiebbar. Ohne JavaScript gehen Ansicht und Feldwahl über die Adresse. %>
<% const keys = Object.keys(LAYERS), li = keys.indexOf(layer), prevL = keys[(li + keys.length - 1) % keys.length], nextL = keys[(li + 1) % keys.length]; %>
<% const w = 1000 / (1 - 2 * border / 100), off = -border / 100 * w, S = m.size || 2048, P = v => ((v + S / 2) / S * 1000).toFixed(1); %>
<div class="fs-title fs-maptitle">
  <h1>Karte<%= st && st.map ? ' · ' + st.map : '' %></h1>
  <% if (m.money !== null) { %><div class="fs-money">Kontostand: <b><%= eur(m.money) %></b></div><% } %>
</div>
<div class="fs-mapview">
  <aside class="fs-legend" id="fs-legend" aria-label="Ansichten der Karte">
    <div class="fs-pager">
      <a class="arr" href="/farming/karte?ansicht=<%= prevL %>" data-step="-1" aria-label="Vorige Ansicht">◀</a>
      <h2 id="fs-ltitle"><%= LAYERS[layer] %></h2>
      <a class="arr" href="/farming/karte?ansicht=<%= nextL %>" data-step="1" aria-label="Nächste Ansicht">▶</a>
    </div>
    <div class="fs-dots"><% keys.forEach(k => { %><a href="/farming/karte?ansicht=<%= k %>" data-layer="<%= k %>" title="<%= LAYERS[k] %>" aria-label="<%= LAYERS[k] %>"><i class="<%= k === layer ? 'on' : '' %>"></i></a><% }) %></div>
    <% for (const k of keys) { %>
      <div class="fs-items" data-group="<%= k %>" data-title="<%= LAYERS[k] %>"<%= k === layer ? '' : ' hidden' %>>
        <% for (const it of groups[k]) { %>
          <button type="button" class="fs-item" data-item="<%= it.key %>"<%- it.raster ? ` data-raster="${it.raster}"` : '' %> title="Klick blendet aus, Rechtsklick zeigt nur diesen Eintrag">
            <span class="sw<%= it.parcel ? ' parcel' : '' %>" style="background:<%= it.color %>"></span>
            <span class="lb"><% if (it.fill) { %><span class="fs-name"><%- icon(it.fill, it.label, 's') %><%= it.label %></span><% } else { %><%= it.label %><% } %></span>
            <span class="n"><%= it.n === null ? '' : it.n %></span>
          </button>
        <% } %>
        <% if (k === 'bodenart') { %><p class="note">Farbe nach der Bodenart mit dem größten Anteil. Eintragen: Abschnitt „Feldumrisse und Boden“ (Admins).</p><% } %>
        <% if (k === 'boden' && raster.length) { %><p class="note">Genau je Fleck aus der Dichtekarte im letzten Autosave. Dünger: hell einmal, dunkel zweimal.</p><% } %>
        <% if (k !== 'besitz' && !gs.some(f => f.source === 'auto')) { %><p class="note"><%= k === 'boden' ? 'Braucht den FTP-Zugang (fields.xml).' : 'Ohne FTP nur, was Mitglieder melden oder planen.' %></p><% } %>
      </div>
    <% } %>
    <p class="note">Linksklick blendet ein oder aus · Rechtsklick: nur dieser Eintrag (noch mal: alle)</p>
    <% if (editor) { %>
      <details class="fs-fold fs-umriss" id="fs-umriss" data-remember="fs-fold-umriss" data-csrf="<%= csrf %>">
        <summary>Feldumrisse und Boden <small>nur Admins</small></summary>
        <div class="in">
          <% if (hasImage) { const f = editor.img.fit; %>
            <form method="post" action="/farming/karte/ausrichten" class="fs-form fs-fitform" data-umriss-fit><input type="hidden" name="_csrf" value="<%= csrf %>">
              <p class="note"><b>Kartenbild ausrichten</b>: so lange schieben, bis die Felder auf dem Bild liegen. Die Vorschau ändert sich sofort.</p>
              <label class="inline"><span class="lb">Größe</span><input type="range" min="50" max="200" step="0.1" value="<%= f.scale %>" data-fit="scale" aria-label="Größe in Prozent"><input name="scale" type="number" min="50" max="200" step="0.1" value="<%= f.scale %>" data-fit="scale"> %</label>
              <label class="inline"><span class="lb">Links / rechts</span><input type="range" min="-500" max="500" step="1" value="<%= f.dx %>" data-fit="dx" aria-label="Verschiebung nach rechts in Metern"><input name="dx" type="number" min="-2000" max="2000" step="1" value="<%= f.dx %>" data-fit="dx"> m</label>
              <label class="inline"><span class="lb">Oben / unten</span><input type="range" min="-500" max="500" step="1" value="<%= f.dz %>" data-fit="dz" aria-label="Verschiebung nach unten in Metern"><input name="dz" type="number" min="-2000" max="2000" step="1" value="<%= f.dz %>" data-fit="dz"> m</label>
              <div class="btns"><button class="btn small def">Ausrichtung speichern</button><button class="btn small" name="reset" value="1">Zurücksetzen</button></div>
            </form>
          <% } %>
          <p class="note" data-umriss-stat></p>
          <div class="btns"><button type="button" class="btn small" data-umriss="erkennen">Aus dem Kartenbild erkennen</button>
            <button type="button" class="btn small" data-umriss="bildweg">Erkannte löschen</button></div>
          <label class="inline"><input type="checkbox" data-umriss-alle> auch Felder, die schon eine Form haben</label>
          <div data-umriss-preview hidden><p class="note" data-umriss-msg></p>
            <div class="btns"><button type="button" class="btn small def" data-umriss="uebernehmen" hidden>Übernehmen</button><button type="button" class="btn small" data-umriss="verwerfen">Verwerfen</button></div></div>
          <p class="note" data-umriss-sel></p>
          <div class="btns"><button type="button" class="btn small" data-umriss="bearbeiten">Umriss bearbeiten</button><button type="button" class="btn small" data-umriss="zeichnen">Neu zeichnen</button>
            <button type="button" class="btn small" data-umriss="auto" title="Eigenen Umriss löschen, dann gilt wieder die Form aus dem Spielstand oder der Kreis">Automatisch</button></div>
          <form method="post" class="fs-form fs-soilform" data-umriss-boden hidden><input type="hidden" name="_csrf" value="<%= csrf %>">
            <p class="note"><b>Bodenverteilung</b> wie im Spiel (Prozent, leer lassen löscht)</p>
            <% for (const [k, l, c] of SOILS) { %><label class="inline"><span class="sw" style="background:<%= c %>"></span><span class="lb"><%= l %></span><input name="<%= k %>" type="number" min="0" max="100" step="any" data-soil="<%= k %>"> %</label><% } %>
            <label class="inline"><span class="lb">Ertragspotenzial</span><input name="yield" type="number" min="0" max="300" step="any" data-soil="yield"> %</label>
            <div class="btns"><button class="btn small def">Boden speichern</button></div>
          </form>
          <div data-umriss-edit hidden><p class="note" data-umriss-hint></p>
            <div class="btns"><button type="button" class="btn small def" data-umriss="speichern">Speichern</button><button type="button" class="btn small" data-umriss="abbrechen">Abbrechen</button></div></div>
        </div>
      </details>
      <% if (stations.length) { %>
        <details class="fs-fold fs-stset" id="fs-stset" data-remember="fs-fold-stset" data-csrf="<%= csrf %>">
          <summary>Stationen setzen <small>nur Admins</small></summary>
          <div class="in">
            <p class="note">Die Stationen kennt der Hub aus dem Spielstand, ihre Position nicht. Station wählen, „Setzen“, dann auf der Karte auf ihr Symbol klicken. Danach ist gleich die nächste ohne Position dran, Esc hört auf.</p>
            <select data-st-pick aria-label="Station">
              <% for (const [k, [l]] of Object.entries(STATION_CATS)) { const xs = stations.filter(s => s.cat === k); if (!xs.length) continue; %>
                <optgroup label="<%= l %>"><% for (const s of xs) { %><option value="<%= s.uid %>"<%= s.fixed ? ' disabled' : '' %>><%= s.name %><%= s.cx !== null ? ' ✔' : '' %></option><% } %></optgroup>
              <% } %>
            </select>
            <div class="btns"><button type="button" class="btn small def" data-st="setzen">Setzen</button><button type="button" class="btn small" data-st="weg">Position entfernen</button></div>
            <p class="note" data-st-msg></p>
          </div>
        </details>
      <% } %>
    <% } %>
    <div class="shows">
      <label class="inline"><input type="checkbox" data-show="nr" checked> Feldnummern</label>
      <label class="inline"><input type="checkbox" data-show="veh"> Fahrzeuge</label>
      <label class="inline"><input type="checkbox" data-show="pal"> Paletten</label>
      <label class="inline"><input type="checkbox" data-show="orte" checked> Orte</label>
      <% if (m.orchards.length) { %><label class="inline"><input type="checkbox" data-show="plant" checked> Plantagen</label><% } %>
    </div>
    <% if (stations.length) { const placed = stations.filter(s => s.cx !== null); %>
      <div class="fs-stfilter">
        <h3>Stationen</h3>
        <% for (const [k, [l, c]] of Object.entries(STATION_CATS)) { const n = placed.filter(s => s.cat === k).length, all = stations.filter(s => s.cat === k).length; if (!all) continue; %>
          <label class="inline"><input type="checkbox" data-show="st-<%= k %>" checked><span class="stsw" style="background:<%= c %>"><svg aria-hidden="true"><use href="#st-<%= k %>"/></svg></span><span class="lb"><%= l %></span><span class="n"><%= n %><%= n < all ? ' / ' + all : '' %></span></label>
        <% } %>
        <% if (placed.length < stations.length) { %><p class="note"><%= stations.length - placed.length %> von <%= stations.length %> noch ohne Position. <%= isAdmin ? 'Setzen: Abschnitt „Stationen setzen“.' : 'Ein Admin setzt sie auf der Karte.' %></p><% } %>
      </div>
    <% } %>
  </aside>
  <div class="fs-mapbox" id="fs-mapbox">
    <svg class="fs-map" id="fs-map" viewBox="0 0 1000 1000" data-layer="<%= layer %>" role="img" aria-label="Karte mit Feldern">
      <defs>
        <%# Eigene Symbole im Stil der Hotspots im Spiel (keine Originalgrafiken) %>
        <symbol id="st-verkauf" viewBox="0 0 16 16"><path d="M8 2v7M4.8 6.2 8 9.4l3.2-3.2M3 10.5V13h10v-2.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="st-einkauf" viewBox="0 0 16 16"><path d="M8 9.4V2M4.8 5.2 8 2l3.2 3.2M3 10.5V13h10v-2.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="st-produktion" viewBox="0 0 16 16"><path d="M2 14V7.5l3.5 2v-2l3.5 2v-2l2 1.2V2.5h2.5V14z" fill="#fff"/></symbol>
        <symbol id="st-tanken" viewBox="0 0 16 16"><path d="M3 14V3.2c0-.7.5-1.2 1.2-1.2h4.6c.7 0 1.2.5 1.2 1.2V14zm1.5-10v3h4V4z" fill="#fff" fill-rule="evenodd"/><path d="M10 7h1.5l1.5 1.5v4a1 1 0 0 1-2 0V10" fill="none" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/></symbol>
        <symbol id="st-haendler" viewBox="0 0 16 16"><path d="M2.5 6.5 3.6 3h8.8l1.1 3.5zM3.5 7.5h9V13h-3.2V9.5H6.7V13H3.5z" fill="#fff"/></symbol>
        <symbol id="st-sonstiges" viewBox="0 0 16 16"><path d="m8 2 1.8 4 4.2.4-3.2 2.8 1 4.2L8 11.2l-3.8 2.2 1-4.2L2 6.4l4.2-.4z" fill="#fff"/></symbol>
      </defs>
      <rect x="-5000" y="-5000" width="11000" height="11000" fill="#262c22"/>
      <rect width="1000" height="1000" fill="#4f6a33"/>
      <% if (hasImage) { %><image id="fs-mapimg" href="/farming/karte.bild?v=<%= mapV %>" x="<%= box.x %>" y="<%= box.y %>" width="<%= box.w %>" height="<%= box.w %>" preserveAspectRatio="none"/><% } %>
      <g class="flds">
        <% for (const g of gs) { const L = g.layer; %>
          <a href="/farming/karte?ansicht=<%= layer %>&amp;feld=<%= g.id %>" data-field="<%= g.id %>"><<%= g.d ? 'path' : 'circle' %> class="fld<%= g.parcel ? ' parcel' : '' %><%= sel && sel.id === g.id ? ' sel' : '' %>" <%- g.d ? `d="${g.d}"` : `cx="${g.cx}" cy="${g.cy}" r="${g.r}"` %>
            style="<%= keys.map(k => `--c-${k}:${L[k][1]}`).join(';') %>"
            <%- keys.map(k => `data-${k}="${L[k][0]}"`).join(' ') %>><title><%= fieldName(g) %> · <%= ha(g.area) %><%= g.farm ? ' · ' + g.farm.name : g.price ? ' · zu kaufen ' + eur(g.price) : '' %><%= g.crop ? ' · ' + g.crop : '' %></title></<%= g.d ? 'path' : 'circle' %>></a>
        <% } %>
      </g>
      <g class="plant"><% for (const o of m.orchards) { %><path d="<%= o.rows.map(r => `M${P(r[0])} ${P(r[1])}L${P(r[2])} ${P(r[3])}`).join('') %>" class="row-<%= o.type.toLowerCase() %>"><title><%= N.fill(o.type) %>-Plantage · <%= o.rows.length %> Reihen</title></path><% } %></g>
      <g class="ras"><% for (const k of raster) { %><image href="/farming/karte/ebene/<%= k %>.png?v=<%= shp.at %>" x="0" y="0" width="1000" height="1000" preserveAspectRatio="none" data-raster="<%= k %>"/><% } %></g>
      <g class="nr"><% for (const g of gs) { %><text x="<%= g.cx %>" y="<%= g.cy %>"><%= g.id %></text><% } %></g>
      <g class="orte"><% for (const p of m.places) { %><g><circle cx="<%= P(p.x) %>" cy="<%= P(p.z) %>" r="<%= Math.max(5, p.radius / S * 1000).toFixed(1) %>" class="ort"/><text x="<%= P(p.x) %>" y="<%= (Number(P(p.z)) - Math.max(6, p.radius / S * 1000) - 3).toFixed(1) %>" class="ort-t"><%= p.name %></text></g><% } %></g>
      <g class="stn"><% for (const s of stations) { %><a href="#" data-station="<%= s.uid %>" class="st st-<%= s.cat %><%= s.cx === null ? ' unplaced' : '' %>" transform="translate(<%= s.cx === null ? '500 500' : s.cx + ' ' + s.cy %>)"><g class="sc"><rect x="-9" y="-9" width="18" height="18" rx="3.5" fill="<%= STATION_CATS[s.cat][1] %>"/><use href="#st-<%= s.cat %>" x="-6.5" y="-6.5" width="13" height="13"/></g><title><%= s.name %> · <%= s.catLabel %></title></a><% } %></g>
      <g class="veh"><% for (const v of m.vehicles.filter(v => !v.pallet && v.x !== null)) { %><rect x="<%= (P(v.x) - 4).toFixed(1) %>" y="<%= (P(v.z) - 4).toFixed(1) %>" width="8" height="8" rx="1.5" fill="<%= v.driver || v.ai ? '#ffd400' : '#fff' %>" stroke="#000"><title><%= v.name %><%= v.driver ? ' · ' + v.driver : v.ai ? ' · Helfer' : '' %></title></rect><% } %></g>
      <g class="pal"><% for (const v of m.vehicles.filter(v => v.pallet && v.x !== null)) { %><circle cx="<%= P(v.x) %>" cy="<%= P(v.z) %>" r="3" fill="#c8a165" stroke="#000"><title><%= v.name %> · <%= v.fill.map(([t, l]) => N.fill(t) + ' ' + liters(l)).join(', ') %></title></circle><% } %></g>
    </svg>
    <div class="fs-zoom">
      <button type="button" data-zoom="1.4" aria-label="Hineinzoomen" title="Hineinzoomen"><svg aria-hidden="true"><use href="#i-plus"/></svg></button>
      <button type="button" data-zoom="0.7" aria-label="Herauszoomen" title="Herauszoomen">−</button>
      <button type="button" data-zoom="0" aria-label="Ganze Karte" title="Ganze Karte"><svg aria-hidden="true"><use href="#i-fit"/></svg></button>
    </div>
    <div class="fs-maphint">Mausrad zoomt · Ziehen verschiebt · Klick auf ein Feld</div>
    <% if (!hasImage) { %><p class="fs-nomap">Kein Kartenbild. <%= isAdmin ? 'In der Seitenverwaltung die Map-Image-Adresse eintragen oder ein eigenes Bild hochladen.' : '' %></p><% } %>

    <div class="fs-finfo" id="fs-finfo"<%= sel ? '' : ' hidden' %>>
      <% if (sel) { const a = sel.source === 'auto' ? sel.auto : null; %>
        <a class="x" href="/farming/karte?ansicht=<%= layer %>" data-close aria-label="Schließen">✕</a>
        <h2><%= fieldName(sel) %></h2>
        <div class="fs-rows">
          <div class="fs-row"><span class="t">Größe</span><span class="v"><%= ha(sel.area) %></span></div>
          <div class="fs-row"><span class="t">Besitzer</span><span class="v"><% if (sel.farm) { %><a href="/farming/hof/<%= sel.farm.id %>"><%= sel.farm.name %></a><% } else { %>zu kaufen für <%= eur(sel.price) %><% } %></span></div>
          <div class="fs-row"><span class="t">Frucht</span><span class="v"><% if (sel.crop) { %><span class="fs-name"><%- icon(sel.cropFill, sel.crop, 's') %><%= sel.crop %></span><% } else { %><%= sel.source === 'auto' ? 'nichts' : 'unbekannt' %><% } %><%= sel.source === 'plan' ? ' (laut Plan)' : '' %></span></div>
          <div class="fs-row"><span class="t">Zustand</span><span class="v"><b><%= sel.state ? N.STATES[sel.state][0] : 'unbekannt' %></b><%= a && a.growth ? ', Stufe ' + a.growth : '' %></span></div>
          <% if (sel.orchard) { %><div class="fs-row"><span class="t">Plantage</span><span class="v"><%= N.fill(sel.orchard) %></span></div><% } %>
          <% if (sel.soil && sel.soil.yield) { %><div class="fs-row"><span class="t">Ertragspotenzial</span><span class="v"><%= de(sel.soil.yield) %> %</span></div><% } %>
          <% if (a) { %><div class="fs-row"><span class="t">Boden</span><span class="v">Kalk <%= a.lime %>/3 · Dünger <%= a.spray %>/2 · Pflug <%= a.plow ? '✔' : '–' %></span></div><% } %>
        </div>
        <% if (sel.soil && sel.soil.parts.length) { %><div class="fs-soil"><div class="bar"><% for (const x of sel.soil.parts) { %><i style="flex:<%= x.pct %>;background:<%= x.color %>"></i><% } %></div><% for (const x of sel.soil.parts) { %><span><i style="background:<%= x.color %>"></i><%= x.label %> <%= de(x.pct) %> %</span><% } %></div><% } %>
        <% if (sel.care.length) { %><div class="chips"><% for (const c of sel.care) { const k = CARE_COLORS[c.key]; %><span class="chip"><i style="background:<%= k || '#999' %>"></i><%= c.label %></span><% } %></div><% } %>
        <% if (a) { %><div class="hint">laut letztem Autosave, abgeholt <%= when(sel.autoAt) %></div><% } %>
        <% if (sel.report) { %><div class="hint"><%= sel.source === 'report' ? '' : 'Ältere Meldung: ' %>gemeldet von <%= sel.report.username || '–' %><%= sel.report.game_day ? ' am ' + (fmtDay(sel.report.game_day) || 'Spieltag ' + sel.report.game_day) : '' %>, <%= when(sel.report.updated_at) %></div><% } %>
        <% if (sel.plan) { %><div class="hint">Plan: <%= sel.plan.crop %>, säen <%= N.MONTHS[sel.plan.sow_month] %>, ernten <%= N.MONTHS[sel.plan.harvest_month] %></div><% } %>
        <% if (user && (!sel.farm || canEdit(sel.farm.id))) { %>
          <form method="post" action="/farming/feld/<%= sel.id %>" class="fs-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
            <label>Frucht <select name="crop_id"><option value="">unbekannt</option><% for (const c of crops) { %><option value="<%= c.id %>"<%= sel.report && sel.report.crop_id === c.id ? ' selected' : '' %>><%= c.name %></option><% } %></select></label>
            <label>Zustand <select name="state"><option value="">unbekannt</option><% for (const [k, [l]] of Object.entries(N.STATES)) { %><option value="<%= k %>"<%= sel.state === k ? ' selected' : '' %>><%= l %></option><% } %></select></label>
            <div class="row"><button class="def">Melden</button>
            <% if (sel.farm) { %><a class="btn small" href="/farming/hof/<%= sel.farm.id %>?tab=kalender&amp;feld=<%= sel.id %>#plan">Plan</a> <a class="btn small" href="/farming/hof/<%= sel.farm.id %>?tab=aufgaben&amp;feld=<%= sel.id %>#neu">Aufgabe</a><% } %></div>
          </form>
        <% } %>
      <% } %>
    </div>
  </div>
</div>
<%# Für die Infokarte beim Klick: Daten je Feld und ein leeres Meldeformular %>
<script type="application/json" id="fs-cards"><%- JSON.stringify(cards).replace(/</g, '\\u003c') %></script>
<template id="fs-reportform">
  <form method="post" class="fs-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Frucht <select name="crop_id"><option value="">unbekannt</option><% for (const c of crops) { %><option value="<%= c.id %>"><%= c.name %></option><% } %></select></label>
    <label>Zustand <select name="state"><option value="">unbekannt</option><% for (const [k, [l]] of Object.entries(N.STATES)) { %><option value="<%= k %>"><%= l %></option><% } %></select></label>
    <div class="row"><button class="def">Melden</button><a class="btn small" data-plan>Plan</a> <a class="btn small" data-task>Aufgabe</a></div>
  </form>
</template>
<script type="application/json" id="fs-stations"><%- JSON.stringify(stations).replace(/</g, '\\u003c') %></script>
<% if (editor) { %>
<script type="application/json" id="fs-umriss-data"><%- JSON.stringify(editor).replace(/</g, '\\u003c') %></script>
<script src="<%= asset('fsdetect.js') %>"></script>
<script src="<%= asset('fshub-umriss.js') %>"></script>
<script src="<%= asset('fshub-stationen.js') %>"></script>
<% } %>
<%- include('_bottom') %>
