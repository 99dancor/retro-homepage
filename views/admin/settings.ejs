<%- include('../partials/head') %>
<%# System → Allgemein: Name der Website und Wartungsmodus. Alles andere hat seine eigene Seite im Baum links. %>
<form method="post" action="/admin/settings">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <fieldset class="groupbox" id="allgemein"><legend>🏠 Website</legend>
    <div class="row">
      <label>Name der Website:<input type="text" name="site_title" class="w100" value="<%= s.site_title %>" maxlength="100"></label>
      <label>Untertitel (Statusleiste):<input type="text" name="site_tagline" class="w100" value="<%= s.site_tagline %>" maxlength="200"></label>
    </div>
    <small>Der Text auf der Startseite steht unter <a href="/admin/startseite#text">Aussehen → Startseite</a>, Farben und Hintergrund unter <a href="/admin/design">Design</a>.</small>
  </fieldset>
  <div class="actions"><button>💾 Speichern</button></div>
</form>
<form method="post" action="/admin/settings">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="maint_form" value="1">
  <fieldset class="groupbox" id="wartung"><legend>🚧 Wartungsmodus</legend>
    <label class="inline"><input type="checkbox" name="maint_on" value="1" <%= s.maint_on === '1' ? 'checked' : '' %>> Seite für alle außer Admins sperren</label>
    <p style="margin:4px 0"><small>Besucher sehen dann nur ein Fenster mit dem Text unten (und einem Anmelden für Admins). Du siehst die Seite weiter, oben steht 🚧. Laufende Spiele und Lobbys brechen beim nächsten Klick ab.</small></p>
    <label>Text auf der Wartungsseite:
      <textarea name="maint_text" rows="4" class="w100"><%= s.maint_text %></textarea></label>
  </fieldset>
  <div class="actions"><button>💾 Speichern</button></div>
</form>
<%- include('../partials/foot') %>
