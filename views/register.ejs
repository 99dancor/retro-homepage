<%- include('partials/head') %>
<div class="window small">
  <div class="titlebar"><span class="ttl">📝 Registrieren</span></div>
  <div class="body">
    <% if (err) { %><div class="msg err">⚠ <%= err %></div><% } %>
    <form method="post" action="/register">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Benutzername:<input type="text" name="username" class="w100" autocomplete="username" required></label>
      <label>Passwort (min. 8 Zeichen):<input type="password" name="password" class="w100" autocomplete="new-password" required></label>
      <label>Passwort wiederholen:<input type="password" name="password2" class="w100" autocomplete="new-password" required></label>
      <div class="actions"><button>Registrieren</button></div>
    </form>
  </div>
</div>
<%- include('partials/foot') %>
