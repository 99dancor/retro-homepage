<%# Seitenverwaltung 2.0: Baum wie in der Computerverwaltung (src/adminnav.js). Die Gruppe der offenen Seite ist aufgeklappt,
    die anderen klappt [+] auf (public/admin.js merkt sich das). Am Handy wird der Baum zur Auswahlliste. %>
<% const nav = adminNav.current(path), badge = k => k === 'inbox' ? counts.inbox : k === 'down' ? counts.down : k === 'popups' ? counts.popups : k === 'links' ? counts.links : 0; %>
<nav class="sv-tree" aria-label="Seitenverwaltung">
  <ul role="tree">
    <li role="treeitem" aria-expanded="true"><span class="sv-root">⚙️ <b><%= site.title %></b></span>
      <ul role="group">
        <% for (const g of adminNav.TREE) { const open = nav.group === g, n = g.badge ? badge(g.badge) : 0; %>
        <li role="treeitem" data-group="<%= g.key %>"<% if (g.kids.length) { %> aria-expanded="<%= open %>"<% } %>>
          <% if (g.kids.length) { %><button type="button" class="tw" data-tw tabindex="-1" aria-hidden="true"><%= open ? '−' : '+' %></button><% } else { %><span class="nt"></span><% } %><a href="<%= g.url || g.kids[0].url %>" class="<%= open && !nav.item ? 'cur' : '' %>"<%= open && !nav.item ? ' aria-current=page' : '' %>><%= g.icon %> <%= g.label %></a><% if (n) { %><i class="n<%= g.badge === 'down' ? '' : '' %>" title="<%= g.badge === 'down' ? n + ' offline' : n + ' warten' %>"><%= n %></i><% } %>
          <% if (g.kids.length) { %>
          <ul role="group">
            <% for (const k of g.kids) { const cur = nav.item === k, kn = k.badge ? badge(k.badge) : 0; %>
            <li role="treeitem"><a href="<%= k.url %>" class="<%= cur ? 'cur' : '' %>"<%= cur ? ' aria-current=page' : '' %>><%= k.icon %> <%= k.label %></a><% if (kn) { %><i class="n<%= k.badge === 'popups' ? ' g' : '' %>"><%= kn %></i><% } %></li>
            <% } %>
          </ul>
          <% } %>
        </li>
        <% } %>
      </ul>
    </li>
  </ul>
  <% if (!embed) { %><p><a href="/">↩ Zur Website</a></p><% } %>
</nav>
<label class="sv-select"><span class="vh">Bereich</span>
  <select aria-label="Bereich der Seitenverwaltung" data-sv-select>
    <% for (const g of adminNav.TREE) { if (!g.kids.length) { %><option value="<%= g.url %>"<%= nav.group === g ? ' selected' : '' %>><%= g.icon %> <%= g.label %></option><% } else { %>
    <optgroup label="<%= g.icon %> <%= g.label %>"><% for (const k of g.kids) { %><option value="<%= k.url %>"<%= nav.item === k ? ' selected' : '' %>><%= k.label %></option><% } %></optgroup>
    <% } } %>
  </select>
</label>
