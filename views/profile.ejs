<%- include('partials/head') %>
<%# Profil = Info-Fenster aus dem Messenger (ICU/DSN): oben Status, Statusnachricht und was gerade läuft, darunter Reiter.
    Bearbeitet wird unter „Konto und Passwort“ (/konto). %>
<% const own = user && user.id === u.id, me = own && !preview; const num = v => Number(v).toLocaleString('de-DE', { maximumFractionDigits: 2 }); %>
<% const asWho = { guest: 'ein Gast', member: 'ein angemeldetes Mitglied', friend: 'ein Freund' }; %>
<% const ICU = '<span class="only-xp">ICU</span><span class="only-98">DSN</span>'; %>
<% const stLabel = s => s === 'dnd' ? '<span class="only-xp">Nicht stören</span><span class="only-98">Beschäftigt</span>' : (STATUS[s] || 'Offline'); %>
<% const uname = encodeURIComponent(u.username), name = displayName(u); %>
<% const VIS = { public: 'alle', members: 'Mitglieder', friends: 'nur Freunde' }; %>
<div class="pf" id="pf">
<% if (own) { %>
  <div class="pf-preview">
    <% if (preview) { %>👁️ So sieht <b><%= asWho[preview] %></b> dein Profil.<% } else { %>👁️ Dein Profil. Ausgeblendetes siehst nur du (grau). Ansehen als:<% } %>
    <% for (const [k, l] of [['guest', 'Gast'], ['member', 'Mitglied'], ['friend', 'Freund']]) { %>
      <a class="btn small<%= preview === k ? ' active' : '' %>" href="<%= profileUrl(u.username) %>?ansicht=<%= k %>"><%= l %></a>
    <% } %>
    <% if (preview) { %><a class="btn small" href="<%= profileUrl(u.username) %>">Zurück</a><% } %>
    <span class="spacer"></span>
    <a class="btn small" href="/konto?reiter=profil">✏️ Profil bearbeiten</a>
  </div>
<% } %>
<% if (msg) { %><div class="msg">✔ <%= msg %></div><% } %>
<div class="pf-head">
  <%- include('partials/avatar', { u, size: 96 }) %>
  <div class="pf-main">
    <h1><%= name %><% if (relation === 'friends') { %> <span class="badge">⭐ Freund</span><% } %><% if (u.role === 'admin') { %> <span class="badge gray">Admin</span><% } %><% if (u.disabled) { %> <span class="badge gray">gesperrt</span><% } %></h1>
    <div class="ids">@<%= u.username %> · <%- ICU %># <%= fmtNumber(card.number) %></div>
    <% if (user || preview) { %>
    <div class="now"><i class="st st-<%= card.status %>" aria-hidden="true"></i> <b><%- stLabel(card.status) %></b>
      <% if (card.activity) { %> · <%= card.activity.icon %> <%= card.activity.what %> „<%= card.activity.name %>“<% if (!own) { %> <a href="<%= card.activity.url %>">Beitreten</a><% } %><% } %>
      <% if (card.lastSeen) { %> · zuletzt online <%= card.lastSeen %><% } %></div>
    <% } %>
    <% if (card.msg) { %><div class="now"><span class="bubble">„<%= card.msg %>“</span></div><% } %>
    <div class="acts">
      <% if (preview || me) { %>
      <% } else if (user) { %>
        <% if (canMessage) { %><a class="btn small def" href="/messenger/mit/<%= uname %>">💬 Nachricht</a><% } %>
        <% if (canInvite) { %><a class="btn small" href="/messenger/mit/<%= uname %>?einladen=1">🎲 Einladen</a><% } %>
        <% if (relation === 'none' && canRequest) { %><a class="btn small" href="/messenger/anfrage/<%= uname %>">➕ Als Freund hinzufügen</a>
        <% } else if (relation === 'received') { %><a class="btn small" href="/messenger/anfrage/<%= uname %>">❔ Anfrage beantworten</a>
        <% } else if (relation === 'sent') { %><%- include('partials/friend-button', { target: u, relation, back: profileUrl(u.username) }) %><% } %>
        <details class="pf-more"><summary class="btn small" title="Mehr">⋯</summary>
          <div class="pf-more-menu window">
            <% if (relation === 'friends') { %><%- include('partials/friend-button', { target: u, relation, back: profileUrl(u.username) }) %><% } %>
            <form method="post" action="/messenger/ignorieren"<% if (!ignoring) { %> data-confirm="<%= name %> ignorieren? <%= name %> kann dir dann nicht mehr schreiben, dich nicht anfragen oder einladen. Eine Freundschaft endet dabei."<% } %>>
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="user" value="<%= u.username %>"><input type="hidden" name="on" value="<%= ignoring ? 0 : 1 %>"><input type="hidden" name="back" value="<%= profileUrl(u.username) %>">
              <button class="small"><%= ignoring ? '✔ Nicht mehr ignorieren' : '🚫 Ignorieren' %></button></form>
            <% if (user.isAdmin) { %><a class="btn small" href="/admin/users/<%= u.id %>">⚙️ In der Seitenverwaltung</a><% } %>
          </div>
        </details>
      <% } else { %><small><a href="/login?next=<%= encodeURIComponent(profileUrl(u.username)) %>">Anmelden</a>, um Freunde hinzuzufügen und Nachrichten zu schreiben.</small><% } %>
    </div>
    <% if (ignoring) { %><p><small>🚫 Du ignorierst <%= name %>.</small></p><% } %>
  </div>
  <div class="side"><% if (visible) { %>Mitglied seit <%= fmtDate(u.created_at) %><br><% } %>Profil: <%= VIS[u.profile_visibility] || 'alle' %><%= u.profile_visibility !== 'public' ? ' 🔒' : '' %></div>
</div>

<% if (!visible) { %>
  <div class="msg pf-locked">🔒 <%= u.profile_visibility === 'friends' ? 'Dieses Profil sehen nur Freunde von ' + name + '.' : 'Dieses Profil sehen nur angemeldete Mitglieder.' %></div>
<% } else { %>
  <% const nArt = artworks ? artworks.length : 0; %>
  <% const T = [['uebersicht', 'Übersicht'], ['spiele', '🎮 Spiele (' + games.length + ')'], artworks && (nArt || me) && ['bilder', '🎨 Bilder (' + (nArt > 8 ? '8+' : nArt) + ')'],
       guestbook && ['freundebuch', '📖 Freundebuch (' + guestbook.length + (guestbook.length === 50 ? '+' : '') + ')'], onSite.friends && ['freunde', '⭐ Freunde (' + friends.length + ')']].filter(Boolean); %>
  <div class="tabs pf-tabs" role="tablist" data-reiter>
    <% T.forEach(([k, l], i) => { %><button type="button" role="tab" id="t-<%= k %>" aria-controls="<%= k %>" aria-selected="<%= i === 0 %>"<%- i ? ' tabindex="-1"' : '' %>><%= l %></button><% }) %>
  </div>

  <section class="tab-page pf-page" id="uebersicht" role="tabpanel" aria-labelledby="t-uebersicht">
    <% if (showcase.length) { %>
    <div class="showcase" aria-label="Vitrine">
      <% for (const v of showcase) { %>
        <a class="panel" href="<%= v.url %>"><small><%= v.title %></small><b class="<%= v.cls || '' %>"><%= v.text || num(v.value) %></b><small><%= v.key %></small></a>
      <% } %>
    </div>
    <% } %>
    <div class="pf-grid">
      <div>
        <fieldset class="groupbox"><legend>Über mich</legend>
          <% if (u.about) { %><p class="about"><%= u.about %></p><% } else { %><p class="muted"><small><%= me ? 'Noch nichts. Unter Konto und Passwort → Profil schreibst du etwas über dich.' : 'Noch nichts.' %></small></p><% } %>
        </fieldset>
        <% if (guestbook && guestbook.length) { %>
        <fieldset class="groupbox"><legend>📖 Zuletzt im Freundebuch</legend>
          <% for (const e of guestbook.slice(0, 2)) { %>
            <div class="pf-gb"><div class="gh"><%- include('partials/avatar', { u: { id: e.author_id, username: e.username, display_name: e.display_name, avatar: e.avatar }, size: 22 }) %> <b><%= displayName(e) %></b><small><%= fmtDate(e.created_at) %></small></div><div class="gt sunken"><%= e.body.length > 160 ? e.body.slice(0, 160) + '…' : e.body %></div></div>
          <% } %>
          <p><small><a href="#freundebuch" data-reiter-link>Alle Einträge »</a></small></p>
        </fieldset>
        <% } %>
      </div>
      <div>
        <% if (user && !own && !preview && (relation === 'friends' || common.length || talked)) { %>
        <fieldset class="groupbox"><legend>🤝 Ihr beide</legend>
          <table class="kv">
            <% if (since) { %><tr><td>Freunde seit</td><td class="num"><%= fmtDate(since) %></td></tr><% } %>
            <tr><td>Gemeinsame Freunde</td><td class="num"><%= common.length %></td></tr>
            <tr><td>Nachrichten</td><td class="num"><%= num(talked) %></td></tr>
          </table>
          <% if (common.length) { %><div class="mini-people"><% for (const c of common.slice(0, 6)) { %><a href="<%= profileUrl(c.username) %>"><%- include('partials/avatar', { u: c, size: 18 }) %> <%= displayName(c) %></a><% } %><% if (common.length > 6) { %><small class="muted">+<%= common.length - 6 %></small><% } %></div><% } %>
        </fieldset>
        <% } %>
        <%# Was hier steht, wählt jeder unter Konto und Passwort → Statistik; der Besitzer sieht Abgewähltes grau %>
        <% const off = k => (rel === 'self' && !siteSettings[k] ? ' class="hidden-val"' : ''); %>
        <% const rows = [boardOpen && onSite.posts && 'posts', guestbookEnabled && onSite.guestbook && 'guestbook', onSite.tracks && 'tracks', onSite.friends && 'friends'].filter(Boolean); %>
        <% if (rows.length || (onSite.recent && recent.length)) { %>
        <fieldset class="groupbox"><legend>📊 Auf der Seite</legend>
          <% if (rows.length) { %>
          <table class="kv">
            <% if (rows.includes('posts')) { %><tr<%- off('posts') %>><td>Forenbeiträge</td><td class="num"><%= num(counts.posts) %></td></tr><tr<%- off('posts') %>><td>Forenthemen</td><td class="num"><%= num(counts.topics) %></td></tr><% } %>
            <% if (rows.includes('guestbook')) { %><tr<%- off('guestbook') %>><td>Einträge im Besucherbuch</td><td class="num"><%= num(counts.guestbook) %></td></tr><% } %>
            <% if (rows.includes('tracks')) { %><tr<%- off('tracks') %>><td>Hochgeladene Musik</td><td class="num"><%= num(counts.tracks) %></td></tr><% } %>
            <% if (rows.includes('friends')) { %><tr<%- off('friends') %>><td>Freunde</td><td class="num"><%= num(friends.length) %></td></tr><% } %>
          </table>
          <% } %>
          <% if (onSite.recent && recent.length) { %>
            <p<%- off('recent') %>><b>Zuletzt im Forum:</b></p>
            <ul><% for (const r of recent) { %><li><a href="/forum/t/<%= r.topic_id %>#b<%= r.id %>"><%= r.title %></a> <small class="muted"><%= fmtDate(r.created_at, true) %></small></li><% } %></ul>
          <% } %>
        </fieldset>
        <% } %>
        <% if (links.length) { %>
        <fieldset class="groupbox" id="links"><legend>🌐 Links</legend>
          <ul class="profile-links">
            <% for (const l of links) { %><li<%- l.private ? ' class="hidden-val"' : '' %>><a href="<%= l.url %>" target="_blank" rel="noopener noreferrer nofollow"><%= l.icon %> <%= l.name %></a> <small class="muted"><%= l.host %></small></li><% } %>
          </ul>
          <% if (rel === 'self') { %><p><small class="muted">Internetverknüpfungen von deinem Desktop. Wer sie sieht, stellst du am Link unter Eigenschaften ein.</small></p><% } %>
        </fieldset>
        <% } %>
      </div>
    </div>
  </section>

  <section class="tab-page pf-page" id="spiele" role="tabpanel" aria-labelledby="t-spiele" hidden>
  <% if (!games.length) { %><p class="muted"><%= me ? 'Noch nichts gespielt. Mit Konto zählen' : 'Noch keine Spiele. Mit Konto zählen' %> <a href="/apps">Andere Games</a><% if (!navHidden.includes('haustier')) { %> und <a href="/haustier/">Pixelpfoten</a><% } %> hier mit.</p>
  <% } else { %>
    <div class="game-stats">
    <% for (const g of games) { %>
      <div class="panel game-card<%= g.hiddenGame ? ' hidden-game' : '' %>">
        <div class="game-title"><a href="<%= g.url %>"><b><%= g.title %></b></a><small class="muted"><%= rel === 'self' && g.see !== 'profil' ? '🔒 ' + { private: 'nur du', friends: 'nur Freunde', members: 'nur Angemeldete' }[g.see] + ' · ' : '' %>zuletzt <%= fmtDate(g.last) %></small></div>
        <table class="kv"><% for (const s of g.stats) { %><tr<%- s.hidden ? ' class="hidden-val"' : '' %>><td><%= s.key %></td><td class="num<%= s.cls ? ' ' + s.cls : '' %>"><%= s.text || num(s.value) %></td></tr><% } %></table>
      </div>
    <% } %>
    </div>
  <% } %>
  <% if (me) { %><p><small class="muted">Wer was sieht: <a href="/konto?reiter=statistik#statistik">Konto und Passwort → Statistik</a></small></p><% } %>
  </section>

  <% if (artworks && (nArt || me)) { %>
  <section class="tab-page pf-page" id="bilder" role="tabpanel" aria-labelledby="t-bilder" hidden>
  <% if (!nArt) { %><p class="muted">Noch keine Bilder. Mal eins in <a href="/paint">🎨 Paint</a> und speichere es.</p>
  <% } else { %>
    <div class="gal-grid">
    <% for (const a of artworks.slice(0, 8)) { %>
      <a class="gal-item" href="/galerie/<%= a.id %>"><img src="/paint/bild/<%= a.id %>/vorschau.png?v=<%= a.updated %>" alt="<%= a.title %>" loading="lazy"><b><%= a.title %></b><small><%= a.byUser !== u.username ? 'von ' + a.by + ' · ' : a.with ? 'mit ' + a.with + ' · ' : '' %><%= a.date %><%= a.visibility === 'private' ? ' · 🔒 privat' : a.visibility === 'members' ? ' · 👥' : '' %></small></a>
    <% } %>
    </div>
    <% if (nArt > 8) { %><p><a href="/galerie?von=<%= encodeURIComponent(u.username) %>">Alle Bilder von <%= name %> »</a></p><% } %>
  <% } %>
  </section>
  <% } %>

  <% if (guestbook) { %>
  <section class="tab-page pf-page" id="freundebuch" role="tabpanel" aria-labelledby="t-freundebuch" hidden>
  <% if (canSign && !preview) { %>
  <form method="post" action="<%= profileUrl(u.username) %>/freundebuch">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Schreib <%= me ? 'etwas in dein eigenes' : name + ' etwas ins' %> Freundebuch:<textarea name="body" maxlength="<%= maxGb %>" required style="min-height:50px"></textarea></label>
    <div class="actions"><button class="small">✍️ Eintragen</button></div>
  </form>
  <% } else if (!user) { %><p><small><a href="/login?next=<%= encodeURIComponent(profileUrl(u.username)) %>">Anmelden</a>, um dich einzutragen.</small></p>
  <% } else if (!me && !preview) { %><p><small class="muted">🔒 Hier dürfen nur Freunde von <%= name %> schreiben.</small></p><% } %>
  <% if (!guestbook.length) { %><p class="muted">Noch keine Einträge.</p><% } %>
  <% for (const e of guestbook) { %>
    <div class="gb-entry" id="g<%= e.id %>">
      <div class="head"><span class="who"><a href="<%= profileUrl(e.username) %>" class="userlink"><%- include('partials/avatar', { u: { id: e.author_id, username: e.username, display_name: e.display_name, avatar: e.avatar }, size: 24 }) %> <%= displayName(e) %></a></span>
        <span><%= fmtDate(e.created_at, true) %>
        <% if (user && (user.isAdmin || user.id === e.author_id || me)) { %>
          <form method="post" action="<%= profileUrl(u.username) %>/freundebuch/<%= e.id %>/loeschen" class="inline" data-confirm="Eintrag löschen?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small danger" title="Löschen">🗑</button></form>
        <% } %></span></div>
      <div class="panel text"><%= e.body %></div>
    </div>
  <% } %>
  </section>
  <% } %>

  <% if (onSite.friends) { %>
  <section class="tab-page pf-page" id="freunde" role="tabpanel" aria-labelledby="t-freunde" hidden>
  <% if (!friends.length) { %><p class="muted">Noch keine Freunde.</p><% } else { %>
    <ul class="people grid"><% for (const f of friends) { %><li><a href="<%= profileUrl(f.username) %>"><%- include('partials/avatar', { u: f, size: 32 }) %> <%= displayName(f) %></a></li><% } %></ul>
  <% } %>
  </section>
  <% } %>
<% } %>
<div class="statusbar"><span><%= own ? (preview ? 'Vorschau: so sieht dich ' + asWho[preview] : 'Dein Profil') : user ? (relation === 'friends' ? 'Du siehst das Profil als Freund' : 'Du siehst das Profil als Mitglied') : 'Du siehst das Profil als Gast' %></span><span class="fixed"><%= u.profile_visibility === 'public' ? '🌐 Öffentlich' : '🔒 ' + (u.profile_visibility === 'friends' ? 'Nur Freunde' : 'Nur Mitglieder') %></span></div>
</div>
<script src="<%= asset('reiter.js') %>"></script>
<%- include('partials/foot') %>
