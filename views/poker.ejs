<%- include('partials/head') %>
<%# Poker (Texas Hold'em): Tische, Spiel und Statistik laufen in public/poker.js; gemischt und gegeben wird auf dem Server (src/poker.js) %>
<div class="bj pk" id="pk" data-csrf="<%= csrf %>" data-user="<%= user ? user.id : '' %>">
  <nav class="menubar bj-nav" role="tablist">
    <a href="#tische" data-view="tische">♠️ Tische</a><a href="#tisch" data-view="tisch" hidden>🟩 Mein Tisch</a><a href="#statistik" data-view="statistik">📊 Statistik</a><a href="#regeln" data-view="regeln">📜 Regeln</a>
    <span class="spacer"></span><span class="bj-me" id="pk-me"></span>
  </nav>
  <div class="bj-main" id="pk-main">
    <% if (!user) { %>
      <div class="bj-guest">
        <p class="bj-big">♠️ Poker</p>
        <p>Texas Hold'em mit anderen Mitgliedern an einem Tisch. Jeder startet mit <b><%= rules.buyin.toLocaleString('de-DE') %> €</b> Spielgeld; Bilanz und Statistik landen in deinem Profil.</p>
        <p><a class="btn" href="/login?next=/poker">Anmelden</a><% if (registrationOpen) { %> <a class="btn" href="/register?next=/poker">Registrieren</a><% } %></p>
      </div>
    <% } %>
  </div>
  <div class="statusbar"><span id="pk-status">Spielgeld, kein echtes Geld.</span></div>
</div>
<dialog class="window mp-dlg" id="pk-dlg">
  <div class="titlebar"><span class="ttl" id="pk-dlg-title"></span></div>
  <form method="dialog" class="body">
    <div id="pk-dlg-body"></div>
    <div class="actions" id="pk-dlg-actions"></div>
  </form>
</dialog>
<% if (user) { %>
<script src="<%= asset('usermenu.js') %>"></script>
<script src="<%= asset('poker.js') %>"></script>
<% } %>
<%- include('partials/foot') %>
