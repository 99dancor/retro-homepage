<div class="startmenu" id="startmenu" data-title="<%= site.title %>">
  <a href="/">🏠 Startseite</a>
  <% const entries = [['blog','/blog','📝 Blog'],['files','/files','📁 Downloads'],['mods','/mods','🧩 Modlisten'],['links','/links','🔗 Links'],['apps','/apps','🎮 Spiele & Apps'],['haustier','/haustier/','🐾 Mein Haustier'],['board','/forum','💬 Forum'],['guestbook','/guestbook','📖 Freundebuch'],['contact','/contact','✉️ Kontakt']]; %>
  <% for (const [key, href, label] of entries) {
       if (navHidden.includes(key)) continue;
       if (key === 'guestbook' && !guestbookEnabled) continue;
       if (key === 'board' && !boardEnabled) continue;
       if (key === 'contact' && !contactEnabled) continue; %>
    <a href="<%= href %>"><%= label %></a>
  <% } %>
  <% for (const p of navPages) { %><a href="/p/<%= p.slug %>">📄 <%= p.title %></a><% } %>
  <hr>
  <a href="/changelog">📜 Changelog</a>
  <a href="/datenschutz">🔒 Datenschutz</a>
  <% if (user) { %>
    <% if (user.canUpload) { %><a href="/files/upload">📤 Datei hochladen</a><% } %>
    <a href="/account">🔑 Mein Konto</a>
    <% if (user.isAdmin) { %><a href="/admin">⚙️ Systemsteuerung</a><% } %>
    <hr>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="menu-item">🚪 <%= user.username %> abmelden…</button></form>
  <% } else { %>
    <hr>
    <a href="/login">🔑 Anmelden…</a>
    <% if (registrationOpen) { %><a href="/register">✏️ Registrieren…</a><% } %>
  <% } %>
</div>
<div class="taskbar">
  <button class="start" id="startbtn" aria-expanded="false" aria-controls="startmenu">🪟 Start</button>
  <div class="tasks" id="tasks"><% if (typeof shellTask !== 'undefined') { %><span class="task"><%= shellTask %></span><% } %></div>
  <div class="tray">
    <button type="button" class="tray-btn" id="displaybtn" title="Darstellung anpassen" aria-label="Darstellung anpassen" aria-expanded="false" aria-controls="displaypanel">🖥️</button>
    <span id="clock"></span>
  </div>
</div>
<div class="window display-panel" id="displaypanel" role="dialog" aria-label="Darstellung" hidden>
  <div class="titlebar"><span class="ttl">🖥️ Darstellung</span><button type="button" class="tb-btn" data-act="close" title="Schließen">×</button></div>
  <form class="body">
    <fieldset class="groupbox"><legend>Schriftgröße</legend>
      <label class="inline"><input type="radio" name="size" value="normal"> Normal</label>
      <label class="inline"><input type="radio" name="size" value="gross"> Groß</label>
      <label class="inline"><input type="radio" name="size" value="sehr-gross"> Sehr groß</label>
    </fieldset>
    <fieldset class="groupbox"><legend>Farben</legend>
      <label class="inline"><input type="radio" name="scheme" value="seite"> Wie die Seite</label>
      <label class="inline"><input type="radio" name="scheme" value="nacht"> Dunkel</label>
      <label class="inline"><input type="radio" name="scheme" value="kontrast"> Hoher Kontrast</label>
    </fieldset>
    <label class="inline"><input type="checkbox" name="still" value="1"> Lauftext und Blinken anhalten</label>
    <p><small>Gilt nur für diesen Browser und wird nicht an den Server geschickt. <a href="/datenschutz">Mehr zu deinen Daten</a></small></p>
    <div class="actions"><button type="button" class="small" data-act="reset">Zurücksetzen</button><button class="small">OK</button></div>
  </form>
</div>
