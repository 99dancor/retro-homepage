<%- include('partials/head') %>
<h1>💌 Nachrichten</h1>
<% if (err) { %><div class="msg err">⚠ <%= err %></div><% } %>
<form method="get" action="/nachrichten" class="actions searchbar">
  <label class="inline">Neue Nachricht an:
    <input type="text" name="an" list="pm-friends" placeholder="Benutzername" required autocomplete="off"></label>
  <datalist id="pm-friends"><% for (const f of friends) { %><option value="<%= f.username %>"><%= displayName(f) %></option><% } %></datalist>
  <button>✍️ Schreiben</button>
</form>
<% if (!conversations.length) { %>
  <p class="muted">Noch keine Nachrichten. Schreib jemandem über sein Profil unter <a href="/nutzer">Mitglieder</a>.</p>
<% } else { %>
<table class="list conv-list">
  <tr><th></th><th>Mit</th><th>Letzte Nachricht</th><th>Wann</th></tr>
  <% for (const c of conversations) { %>
  <tr class="<%= c.unread ? 'unread' : '' %>">
    <td class="av"><%- include('partials/avatar', { u: { id: c.other, username: c.username, display_name: c.display_name, avatar: c.avatar }, size: 32 }) %></td>
    <td><a href="/nachrichten/<%= encodeURIComponent(c.username) %>"><b><%= displayName(c) %></b></a><% if (c.unread) { %> <span class="badge"><%= c.unread %> neu</span><% } %></td>
    <td class="preview"><%= c.from_id === user.id ? 'Du: ' : '' %><%= c.body.length > 80 ? c.body.slice(0, 80) + '…' : c.body %></td>
    <td><%= fmtDate(c.created_at, true) %></td>
  </tr>
  <% } %>
</table>
<% } %>
<p><small class="muted">Privatnachrichten sehen nur ihr beide. Sie liegen unverschlüsselt auf dem Server, mehr dazu unter <a href="/datenschutz#profil">Datenschutz</a>.</small></p>
<%- include('partials/foot') %>
