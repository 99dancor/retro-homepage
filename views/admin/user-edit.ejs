<%- include('../partials/head') %>
<p><a href="/admin/users">« Alle Nutzer</a></p>
<% if (err) { %><div class="msg err">⚠ <%= err %></div><% } %>
<% const self = u.id === user.id; %>
<form method="post" action="/admin/users/<%= u.id %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <p>Registriert am <%= fmtDate(u.created_at) %> · letzter Login: <%= u.last_login ? fmtDate(u.last_login, true) : 'nie' %></p>
  <fieldset class="groupbox"><legend>Profil</legend>
    <div class="avatar-edit"><%- include('../partials/avatar', { u, size: 48 }) %>
      <div><b><%= displayName(u) %></b> <small>@<%= u.username %></small> · <a href="<%= profileUrl(u.username) %>">Profil ansehen</a><br>
      <small>Sichtbar für: <%= { public: 'alle Besucher', members: 'angemeldete Mitglieder', friends: 'nur Freunde' }[u.profile_visibility] %></small></div></div>
    <% if (u.about) { %><p class="about"><small><%= u.about %></small></p><% } %>
    <p><small>Bei unpassenden Angaben kannst du sie hier zurücksetzen:</small></p>
    <% if (u.display_name) { %><label class="inline"><input type="checkbox" name="reset_name" value="1"> Anzeigename „<%= u.display_name %>“ entfernen</label><% } %>
    <% if (u.avatar) { %><label class="inline"><input type="checkbox" name="reset_avatar" value="1"> Profilbild entfernen</label><% } %>
    <% if (u.about) { %><label class="inline"><input type="checkbox" name="reset_about" value="1"> „Über mich“ leeren</label><% } %>
    <% if (ks) { %><label class="inline"><input type="checkbox" name="reset_kasse" value="1"> Kasse der Kartenspiele (Kontostand <%= ks.balance.toLocaleString('de-DE') %> €, Bilanz <%= (ks.balance - ks.bought).toLocaleString('de-DE') %> €) zurücksetzen</label><% } %>
    <% if (bj.sessions) { %><label class="inline"><input type="checkbox" name="reset_blackjack" value="1"> Blackjack-Bilanz (<%= bj.balance.toLocaleString('de-DE') %> €, <%= bj.hands %> Hände) auf null setzen</label><% } %>
    <% if (pk.sessions) { %><label class="inline"><input type="checkbox" name="reset_poker" value="1"> Poker-Bilanz (<%= pk.balance.toLocaleString('de-DE') %> €, <%= pk.hands %> Hände) auf null setzen</label><% } %>
    <% if (dk.games) { %><label class="inline"><input type="checkbox" name="reset_durak" value="1"> Durak-Statistik (<%= dk.games %> Spiele, <%= dk.duraks %>× Durak) löschen</label><% } %>
    <% for (const g of cg) if (g.t.games) { %><label class="inline"><input type="checkbox" name="reset_<%= g.id %>" value="1"> <%= g.title %>-Statistik (<%= g.t.games %> Spiele, <%= g.t.wins %> gewonnen) löschen</label><% } %>
    <% if (cw.solved || cw.streak) { %><label class="inline"><input type="checkbox" name="reset_crossword" value="1"> Kreuzworträtsel-Stand und Serie (<%= cw.solved %> gelöst) löschen</label><% } %>
    <% if (sd.solved || sd.streak) { %><label class="inline"><input type="checkbox" name="reset_sudoku" value="1"> Sudoku-Stand und Serie (<%= sd.solved %> gelöst) löschen</label><% } %>
    <% if (ms.games) { %><label class="inline"><input type="checkbox" name="reset_minesweeper" value="1"> Minesweeper-Statistik und Bestzeiten (<%= ms.games %> Spiele) löschen</label><% } %>
  </fieldset>
  <fieldset class="groupbox"><legend>Rechte</legend>
    <label>Rolle:
      <select name="role" <%= self ? 'disabled' : '' %>><option value="user" <%= u.role === 'user' ? 'selected' : '' %>>Nutzer</option><option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin (darf alles)</option></select>
    </label>
    <label class="inline"><input type="checkbox" name="can_upload" value="1" <%= u.can_upload ? 'checked' : '' %>> Darf selbst Dateien hochladen</label>
    <label class="inline"><input type="checkbox" name="disabled" value="1" <%= u.disabled ? 'checked' : '' %> <%= self ? 'disabled' : '' %>> Konto gesperrt</label>
  </fieldset>
  <fieldset class="groupbox"><legend>Gruppen</legend>
    <% if (!allGroups.length) { %><small>Noch keine Gruppen angelegt.</small><% } %>
    <% for (const g of allGroups) { %><label class="inline"><input type="checkbox" name="groups" value="<%= g.id %>" <%= userGroups.includes(g.id) ? 'checked' : '' %>> <%= g.name %></label><% } %>
  </fieldset>
  <fieldset class="groupbox"><legend>Neues Passwort setzen (optional)</legend>
    <input type="text" name="password" minlength="8" autocomplete="off" placeholder="leer lassen = unverändert">
  </fieldset>
  <div class="actions"><button>💾 Speichern</button></div>
</form>
<% if (!self) { %>
<form method="post" action="/admin/users/<%= u.id %>/delete" data-confirm="Nutzer <%= u.username %> wirklich löschen?" class="actions">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">🗑 Nutzer löschen</button>
</form>
<% } %>
<%- include('../partials/foot') %>
