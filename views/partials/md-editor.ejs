<%# Markdown-Editor mit Bild-Upload und Vorschau. Erwartet: name, value %>
<div class="editor" data-editor>
  <div class="editor-tools">
    <button type="button" class="small" data-md="**|**" title="Fett"><b>F</b></button>
    <button type="button" class="small" data-md="*|*" title="Kursiv"><i>K</i></button>
    <button type="button" class="small" data-md="## |" title="Überschrift">H</button>
    <button type="button" class="small" data-md="[|](https://)" title="Link">🔗 Link</button>
    <button type="button" class="small" data-md="- |" title="Liste">• Liste</button>
    <button type="button" class="small" data-md="> |" title="Zitat">❝ Zitat</button>
    <button type="button" class="small" data-md="```\n|\n```" title="Code">&lt;/&gt;</button>
    <label class="btn small" style="margin:0">🖼️ Bild hochladen…<input type="file" accept="image/*" multiple data-upload hidden></label>
    <button type="button" class="small" data-library>📚 Aus Bibliothek</button>
    <button type="button" class="small" data-preview>👁 Vorschau</button>
    <span data-status class="muted"></span>
  </div>
  <textarea name="<%= name %>" class="code"><%= value || '' %></textarea>
  <div class="panel content preview" data-preview-box hidden></div>
  <div class="panel" data-library-box hidden><div class="thumbs" data-library-list>Lade…</div></div>
  <small>Formatierung mit <a href="https://www.markdownguide.org/basic-syntax/" target="_blank" rel="noopener">Markdown</a>. Bilder kannst du auch per Drag & Drop oder Strg+V ins Textfeld einfügen.</small>
</div>
