<div class="startmenu" id="startmenu" data-title="<%= site.title %>">
  <a href="/">🏠 Startseite</a>
  <%# Einträge: [Schlüssel, Adresse, Beschriftung] oder [Gruppe, Beschriftung, [Einträge]] → Untermenü wie bei Windows 98 %>
  <% const entries = [['blog','/blog','📝 Blog'],
       ['dokumente','📂 Dokumente',[['files','/files','📁 Downloads'],['mods','/mods','🧩 Modlisten'],['links','/links','🔗 Links']]],
       ['spiele','🎮 Spiele und Apps',[['blackjack','/blackjack','🃏 Blackjack'],['paint','/paint','🎨 Paint'],['zufall','/zufall','🎲 Zufallsgenerator'],['musik','/musik','🎵 Musikplayer'],['apps','/apps','🕹️ Andere Games']]],
       ['haustier','/haustier/','🐾 Mein Haustier'],['galerie','/galerie','🖼️ Galerie'],['board','/forum','💬 Forum'],['nutzer','/nutzer','👥 Mitglieder'],['guestbook','/guestbook','📖 Besucherbuch'],['contact','/contact','✉️ Kontakt']];
     const shown = (key) => !(navHidden.includes(key) || (key === 'guestbook' && !guestbookEnabled) || (key === 'board' && !boardEnabled) ||
       (key === 'blackjack' && !blackjackEnabled) || (key === 'paint' && !paintEnabled) || (key === 'galerie' && !galleryEnabled) || (key === 'contact' && !contactEnabled)); %>
  <% for (const [key, a, b] of entries) {
       if (Array.isArray(b)) { const items = b.filter(([k]) => shown(k)); if (!items.length) continue; %>
    <div class="sub"><button type="button" class="menu-item sub-toggle" aria-expanded="false"><%= a %></button><div class="submenu">
      <% for (const [, href, label] of items) { %><a href="<%= href %>"><%= label %></a><% } %>
    </div></div>
  <% } else if (shown(key)) { %>
    <a href="<%= a %>"><%= b %></a>
  <% } } %>
  <% for (const p of navPages) { %><a href="/p/<%= p.slug %>">📄 <%= p.title %></a><% } %>
  <hr>
  <a href="/changelog">📜 Changelog</a>
  <a href="/datenschutz">🔒 Datenschutz</a>
  <% if (user) { %>
    <% if (user.canUpload) { %><a href="/files/upload">📤 Datei hochladen</a><% } %>
    <div class="sub"><button type="button" class="menu-item sub-toggle" aria-expanded="false">👤 Mein Konto</button><div class="submenu">
      <a href="<%= profileUrl(user.username) %>">👤 Mein Profil</a>
      <a href="/nachrichten" id="pm-menu">💌 Nachrichten<% if (unreadPm) { %> (<%= unreadPm %>)<% } %></a>
      <a href="/account">🔑 Kontoeinstellungen</a>
    </div></div>
    <% if (user.isAdmin) { %><a href="/admin">⚙️ Systemsteuerung</a><% } %>
    <hr>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="menu-item">🚪 <%= user.name %> abmelden…</button></form>
  <% } else { %>
    <hr>
    <a href="/login">🔑 Anmelden…</a>
    <% if (registrationOpen) { %><a href="/register">✏️ Registrieren…</a><% } %>
  <% } %>
</div>
<div class="taskbar">
  <button class="start" id="startbtn" aria-expanded="false" aria-controls="startmenu">🪟 Start</button>
  <div class="tasks" id="tasks"><% if (typeof shellTask !== 'undefined') { %><span class="task"><%= shellTask %></span><% } %></div>
  <div class="tray">
    <% if (user) { %><a class="tray-btn pm-tray" id="pmtray" href="/nachrichten" title="<%= unreadPm ? unreadPm + ' ungelesene Nachrichten' : 'Nachrichten' %>"<%= unreadPm ? '' : ' hidden' %>>💌<span class="pm-count"><%= unreadPm %></span></a><% } %>
    <% if (user) { %><button type="button" class="tray-btn notify-btn" id="notifybtn" title="Benachrichtigungen" aria-label="Benachrichtigungen" aria-expanded="false" aria-controls="notifypanel">🔔<span class="notify-count"<%= unreadNotify ? '' : ' hidden' %>><%= unreadNotify %></span></button><% } %>
    <button type="button" class="tray-btn" id="displaybtn" title="Darstellung anpassen" aria-label="Darstellung anpassen" aria-expanded="false" aria-controls="displaypanel">🖥️</button>
    <button type="button" class="tray-btn" id="volumebtn" title="Lautstärke" aria-label="Lautstärke" aria-expanded="false" aria-controls="volumepanel">🔊</button>
    <span id="clock"></span>
  </div>
</div>
<%- include('display-panel') %>
<% if (user) { %>
<%# Benachrichtigungen: öffnet sich über die 🔔 neben der Uhr, Logik in public/notify.js %>
<div class="window notify-panel" id="notifypanel" role="dialog" aria-label="Benachrichtigungen" hidden data-csrf="<%= csrf %>">
  <div class="titlebar"><span class="ttl">🔔 Benachrichtigungen</span></div>
  <div class="body">
    <div class="notify-list sunken" id="notifylist"><p class="muted">Lade …</p></div>
    <div class="actions"><button type="button" class="small" data-nact="read">✔ Alle gelesen</button><a class="btn small" href="/benachrichtigungen">Alle anzeigen</a><a class="btn small" href="/account#benachrichtigungen" title="Einstellungen">⚙️</a></div>
  </div>
</div>
<% } %>
<%# Lautstärke: öffnet sich über den 🔊-Knopf neben der Uhr, Logik in public/sound.js %>
<div class="window volume-panel" id="volumepanel" role="dialog" aria-label="Lautstärke" hidden>
  <div class="titlebar"><span class="ttl">🔊 Lautstärke</span></div>
  <div class="body">
    <div class="vol-cols">
      <label class="vol-col"><span>Musik</span><input type="range" class="vertical" name="musik" min="0" max="100" aria-label="Lautstärke Musik"><output></output></label>
      <label class="vol-col"><span>Effekte</span><input type="range" class="vertical" name="effekte" min="0" max="100" aria-label="Lautstärke Effekte"><output></output></label>
    </div>
    <label class="inline"><input type="checkbox" name="stumm"> Ton aus</label>
  </div>
</div>
