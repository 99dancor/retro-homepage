<%- include('partials/head') %>
<h1>👥 Mitglieder</h1>
<% if (msg) { %><div class="msg">✔ <%= msg %></div><% } %>
<% if (user && incoming.length) { %>
<fieldset class="groupbox"><legend>🔔 Freundschaftsanfragen</legend>
  <ul class="people">
  <% for (const r of incoming) { %>
    <li><%- include('partials/avatar', { u: r, size: 32 }) %> <a href="<%= profileUrl(r.username) %>"><b><%= displayName(r) %></b></a> <small class="muted">angefragt am <%= fmtDate(r.asked_at) %></small>
      <%- include('partials/friend-button', { target: r, relation: 'received', back: '/nutzer' }) %></li>
  <% } %>
  </ul>
</fieldset>
<% } %>
<% if (user) { %>
<fieldset class="groupbox"><legend>⭐ Meine Freunde (<%= friends.length %>)</legend>
  <% if (!friends.length) { %><p class="muted">Noch keine Freunde. Such unten nach Mitgliedern und schick ihnen eine Anfrage.</p><% } else { %>
  <ul class="people grid">
  <% for (const f of friends) { %>
    <li><a href="<%= profileUrl(f.username) %>"><%- include('partials/avatar', { u: f, size: 32 }) %> <%= displayName(f) %></a>
      <a class="btn small" href="/nachrichten/<%= encodeURIComponent(f.username) %>" title="Nachricht schreiben">💌</a></li>
  <% } %>
  </ul>
  <% } %>
  <% if (outgoing.length) { %><p><small>Warten auf Antwort: <% outgoing.forEach((o, i) => { %><%= i ? ', ' : '' %><a href="<%= profileUrl(o.username) %>"><%= displayName(o) %></a><% }) %></small></p><% } %>
</fieldset>
<% } %>
<form method="get" action="/nutzer" class="actions searchbar">
  <input type="search" name="q" value="<%= q %>" placeholder="Name suchen …" aria-label="Name suchen">
  <button>🔍 Suchen</button>
  <% if (q) { %><a href="/nutzer">Alle zeigen</a><% } %>
  <small><%= total %> <%= total === 1 ? 'Mitglied' : 'Mitglieder' %></small>
</form>
<% if (!user) { %><p class="muted"><small>Gäste sehen nur Mitglieder mit öffentlichem Profil. <a href="/login?next=/nutzer">Anmelden</a> zeigt alle.</small></p><% } %>
<% if (!members.length) { %><p class="muted">Niemand gefunden.</p><% } else { %>
<table class="list people-table">
  <tr><th></th><th>Name</th><th>Mitglied seit</th></tr>
  <% for (const m of members) { %>
  <tr>
    <td class="av"><%- include('partials/avatar', { u: m, size: 32 }) %></td>
    <td><a href="<%= profileUrl(m.username) %>"><b><%= displayName(m) %></b></a><% if (m.display_name) { %> <small class="muted">@<%= m.username %></small><% } %>
      <% if (m.role === 'admin') { %> <span class="badge gray">Admin</span><% } %><% if (m.friend) { %> <span class="badge">⭐ Freund</span><% } %><% if (user && m.id === user.id) { %> <span class="badge gray">Du</span><% } %></td>
    <td><%= fmtDate(m.created_at) %></td>
  </tr>
  <% } %>
</table>
<% } %>
<% if (pages > 1) { %>
  <p class="actions"><% for (let i = 1; i <= pages; i++) { %><a class="btn small" href="/nutzer?page=<%= i %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"><%= i === page ? '[' + i + ']' : i %></a><% } %></p>
<% } %>
<%- include('partials/foot') %>
