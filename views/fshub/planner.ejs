<%- include('_top') %>
<%# Produktionsplaner: oben die Bereiche (auf der Karte, eigene Gebäude, Katalog aus dem Shop), links deren Gebäude, rechts das gewählte
    mit Lager, Produktionen, Rezept und Rechner. Alles kommt aus dem Spiel (src/fsprod.js), nichts wird von Hand eingetragen.
    Kein JavaScript nötig. %>
<% const amt = v => de(v, Number.isInteger(v) ? 0 : v < 10 ? 2 : 1); const num = v => (v === null || v === undefined ? '' : String(v));
   const escT = t => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;');
   const item = (x, n) => `<a class="pl-it" href="/farming/preise?w=${encodeURIComponent(x.fill)}" title="Preis von ${escT(x.name)}">${icon(x.fill, x.name, 's')}${escT(amt(n === undefined ? x.amount : n))} ${escT(x.name)}</a>`;
   const items = xs => xs.map(x => item(x)).join('');
   const link = (b, p, extra) => plannerUrl(b.key, p) + (q ? '&q=' + encodeURIComponent(q) : '') + (extra || '');
   const secUrl = k => '/farming/produktion?bereich=' + k; %>
<div class="fs-title"><h1>Produktionsplaner</h1>
  <% if (m.money !== null) { %><div class="fs-money">Kontostand: <b><%= eur(m.money) %></b></div><% } %>
  <div class="sub">Gebäude wählen, dann eine Produktion: Rezept, Zyklen und der Rechner. <%= dpp > 1 ? `Ein Monat hat ${dpp} Spieltage.` : '' %></div>
</div>
<div class="fs-bar">
  <nav class="fs-tabs" aria-label="Bereiche des Planers">
    <% for (const [k, l] of Object.entries(SECTIONS)) { %><a href="<%= secUrl(k) %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"<%- q ? '' : ` data-last="planner:${k}"` %><%- section === k ? ' class="on" aria-current="page"' : '' %>><%= l %> <span class="n"><%= lists[k].length %></span></a><% } %>
  </nav>
  <form class="fs-search" method="get" action="/farming/produktion" role="search">
    <input type="hidden" name="bereich" value="<%= section %>">
    <input type="search" name="q" value="<%= q %>" placeholder="Gebäude, Produktion oder Ware" aria-label="Im Planer suchen" data-filter=".pl-list">
    <button class="small">Suchen</button><% if (q) { %> <a class="btn small" href="<%= secUrl(section) %>">Alle zeigen</a><% } %>
  </form>
</div>
<% if (!gameData) { %><p class="hint">Rezepte, Lager und den Katalog kennt der Hub erst mit der Mod „Farming Hub Export“.<%= isAdmin ? ' Seitenverwaltung → Farming → Kartendaten aus dem Spiel.' : '' %></p>
<% } else if (gameData.version < 2) { %><p class="hint">Die Mod „Farming Hub Export“ auf dem Server ist noch Version 1. Mit Version 2 kommen alle Produktionen aus dem Shop und die Lager dazu.</p><% } %>
<% if (!list.length) { %>
  <p class="hint"><%= q ? `Nichts gefunden für „${q}“.` : section === 'eigene' ? 'Noch kein Hof hat selbst ein Produktionsgebäude gebaut.' : section === 'karte' ? 'Auf dieser Karte stehen keine Produktionen, oder der Hub kennt sie noch nicht.' : 'Der Katalog kommt mit der Mod „Farming Hub Export“.' %></p>
<% } %>
<%# Links die Gebäude, nach DLC bzw. Hof gruppiert und zuklappbar; die Liste scrollt für sich, die Ansicht rechts bleibt stehen %>
<% const groups = []; for (const b of list) { const g = section === 'katalog' ? (b.dlc || 'Grundspiel') : section === 'eigene' ? (b.farm ? b.farm.name : '') : ''; let e = groups.find(x => x.name === g); if (!e) groups.push(e = { name: g, items: [] }); e.items.push(b); } %>
<div class="fs-planner" data-section="<%= section %>">
  <div class="pl-list" role="list" aria-label="Gebäude">
    <% for (const g of groups) { const hasSel = sel && g.items.some(b => b.key === sel.key); const open = q || groups.length <= 2 || hasSel; %>
      <% if (g.name && groups.length > 1) { %><details class="pl-grp"<%= open ? ' open' : '' %>><summary><%= g.name %> <span class="n"><%= g.items.length %></span></summary><% } %>
      <% const seen = new Set(); for (const b0 of g.items) { const base = baseName(b0.label); if (seen.has(base)) continue; seen.add(base);
           const vs = section === 'eigene' ? [b0] : g.items.filter(x => baseName(x.label) === base); const b = (sel && vs.find(x => x.key === sel.key)) || vs[0];
           const on = b.recipes.filter(r => r.active).length, prices = vs.map(x => x.price).filter(Boolean); %>
        <% const isSel = sel && vs.some(x => x.key === sel.key); %>
        <a role="listitem" class="pl-b<%= isSel ? ' sel' : '' %>" href="<%= link(b) %>"<%= isSel ? ' aria-current=true' : '' %> data-q="<%= vs.map(searchText).join(' ') %>">
          <span class="pl-n"><%= vs.length > 1 ? base : b.label %></span>
          <span class="pl-p"><%= section === 'katalog' || !b.farm ? (vs.length > 1 && prices.length > 1 ? 'ab ' + eur(Math.min(...prices)) : b.price ? eur(b.price) : '') : b.farm.name %></span>
          <span class="pl-m"><%= vs.length > 1 ? vs.length + ' Größen · ' : '' %><%= b.recipes.length %> <%= b.recipes.length === 1 ? 'Produktion' : 'Produktionen' %><%= b.mode ? ' · ' + MODES[b.mode].toLowerCase() : '' %><% if (section !== 'katalog' && on) { %> · <span class="ok"><%= on %> läuft</span><% } %><%= section === 'karte' && b.farm ? ' · ' + b.farm.name : '' %></span>
        </a>
      <% } %>
      <% if (g.name && groups.length > 1) { %></details><% } %>
    <% } %>
    <p class="hint pl-none" hidden>Nichts gefunden.</p>
  </div>

  <% if (sel) { %>
  <section class="pl-win" aria-label="<%= sel.label %>">
    <header class="pl-head">
      <div><h2><%= sel.label %></h2>
        <div class="pl-sub"><b><%= sel.price ? eur(sel.price) : '' %></b>
          <% if (sel.mode) { %><span class="pl-mode <%= sel.mode %>" title="<%= sel.mode === 'parallel' ? 'Jede aktive Produktion hat ihre vollen Zyklen' : 'Alle aktiven Produktionen teilen sich die Zyklen des Gebäudes' %>"><%= MODES[sel.mode] %></span><% } %>
          <% if (sel.section !== 'katalog') { %><span class="pl-mode"><%= sel.farm ? sel.farm.name : 'gehört niemandem' %></span><% } %>
          <% if (sel.dlc) { %><span class="pl-mode"><%= sel.dlc %></span><% } %>
        </div>
      </div>
      <div class="row">
        <% if (station && station.placed) { %><a class="btn small" href="/farming/karte?station=<%= encodeURIComponent(station.uid) %>">Auf der Karte</a><% } %>
        <% if (sel.farm) { %><a class="btn small" href="/farming/hof/<%= sel.farm.id %>?tab=produktion">Zum Hof</a><% } %>
      </div>
    </header>
    <p class="hint pl-modehint"><%= sel.mode === 'seriell' ? 'Seriell: Die Produktionen teilen sich die Zyklen des Gebäudes. Laufen zwei gleichzeitig, braucht jede doppelt so lange.' : sel.mode === 'parallel' ? 'Parallel: Alle eingeschalteten Produktionen laufen gleichzeitig, jede mit ihren vollen Zyklen.' : '' %></p>
    <% if (sel.where) { %><div class="pl-where">Steht <%= /^bei /.test(sel.where) ? sel.where : "bei " + sel.where %></div><% } %>
    <% if (variants.length > 1) { %>
      <nav class="pl-sizes" aria-label="Größen"><% for (const v of variants) { %><a href="<%= link(v) %>"<%- v.key === sel.key ? ' class="on" aria-current="true"' : '' %>><b><%= sizeName(v) %></b><small><%= v.price ? eur(v.price) : '' %><%= v.recipes[0] && v.recipes[0].cycles ? ' · ' + amt(v.recipes[0].cycles) + ' Zyklen' : '' %></small></a><% } %></nav>
    <% } %>
    <% if (same.length) { %><div class="pl-where">Gibt es auch: <% same.forEach((b, i) => { %><%= i ? ' · ' : '' %><a href="<%= link(b) %>"><%= b.section === 'katalog' ? 'im Katalog' + (b.dlc ? ' (' + b.dlc + ')' : ' (Grundspiel)') + (b.price ? ', ' + eur(b.price) : '') : b.label + (b.farm ? ' (' + b.farm.name + ')' : ' (Karte)') %></a><% }) %></div><% } %>

    <% const store = sel.storage.filter(x => x.cap || x.level); %>
    <% if (store.length) { %>
      <details class="pl-fold pl-store"<%= store.length <= 8 ? ' open' : '' %>><summary><%= sel.section === 'katalog' ? 'Lagerplatz' : 'Lager beim letzten Speichern' %> <span class="n"><%= store.length %></span></summary>
        <div class="pl-storegrid">
        <% for (const x of store.sort((a, b) => (b.level || 0) / (b.cap || 1) - (a.level || 0) / (a.cap || 1))) { const pct = x.cap ? Math.min(100, Math.round((x.level || 0) / x.cap * 100)) : null; %>
          <div class="pl-fill"><span class="fs-name"><%- icon(x.fill, x.name, 's') %><a href="/farming/preise?w=<%= encodeURIComponent(x.fill) %>"><%= x.name %></a></span>
            <% if (x.level !== null && x.level !== undefined) { %><span class="bar wide" title="<%= pct === null ? '' : pct + ' %' %>"><i style="width:<%= pct === null ? 0 : pct %>%;<%= pct !== null && pct >= 90 ? 'background:var(--g-warn)' : '' %>"></i></span><% } %>
            <span class="v"><%= x.level !== null && x.level !== undefined ? liters(x.level) : '' %><%= x.cap ? (x.level !== null && x.level !== undefined ? ' / ' : '') + liters(x.cap) : '' %></span></div>
        <% } %>
        </div>
        <% if (sel.section !== 'katalog') { %><p class="hint">So voll wie beim letzten Autosave des Servers.</p><% } %>
      </details>
    <% } %>

    <div class="pl-body">
    <div class="pl-recipes" role="list" aria-label="Produktionen">
      <div class="pl-rh" aria-hidden="true"><span>Produktion</span><span>Braucht → liefert je Zyklus</span><span class="num">Zyklen / Monat</span><span class="num">Kosten / Monat</span></div>
      <% for (const r of sel.recipes) { const on = rec && rec.id === r.id; %>
        <div class="pl-r<%= on ? ' hl' : '' %>" role="listitem">
          <span class="pl-rn"><a href="<%= link(sel, r.id) %>"<%= on ? ' aria-current=true' : '' %>><b><%= r.name %></b></a><% if (sel.section !== 'katalog') { %> <small class="<%= r.active ? 'ok' : 'hint' %>"><%= r.active ? '▶ läuft' : '⏸ aus' %></small><% } %></span>
          <span class="pl-rf"><%- r.inputs.length ? items(r.inputs) : '<span class="hint">nichts</span>' %><span class="pl-arrow" aria-label="wird zu">▶</span><%- r.outputs.length ? items(r.outputs) : '<span class="hint">–</span>' %></span>
          <span class="num"><%= r.cycles ? amt(r.cycles) : '–' %></span>
          <span class="num"><%= r.cost ? eur(r.cost) : '–' %></span>
        </div>
      <% } %>
      <% if (!sel.recipes.length) { %><p class="hint">Keine Produktionen.</p><% } %>
    </div>

    <% if (rec) { %>
      <div class="pl-rec">
        <div class="pl-rechead"><h3>Rezept: <%= rec.name %></h3></div>
        <% if (rec.inputs.length || rec.outputs.length) { %>
          <div class="pl-flow"><div class="pl-side"><%- items(rec.inputs) || '<span class="hint">nichts</span>' %></div><span class="pl-arrow" aria-label="wird zu">▶</span><div class="pl-side"><%- items(rec.outputs) || '<span class="hint">nichts</span>' %></div></div>
        <% } else { %><p class="hint">Das Rezept kennt der Hub erst mit der Mod „Farming Hub Export“.</p><% } %>
        <% if (info) { %>
          <div class="pl-cyc">
            <div><small>Zyklen pro Monat</small><b><%= amt(info.perMonth) %></b></div>
            <div><small>pro Jahr</small><b><%= amt(info.perYear) %></b></div>
            <% if (dpp > 1) { %><div><small>pro Spieltag</small><b><%= de(info.perDay, 1) %></b></div><% } %>
            <div><small>Kosten pro Monat</small><b><%= rec.cost ? eur(rec.cost) : '–' %></b></div>
            <% for (const o of rec.outputs.slice(0, 2)) { %><div><small><%= o.name %> pro Monat</small><b><%= amt(o.amount * info.perMonth) %></b></div><% } %>
          </div>
          <% if (sel.mode === 'seriell') { %><p class="hint">Seriell: Die Zyklen gelten, solange diese Produktion allein läuft.</p><% } %>
        <% } %>
        <% if (herd.length) { %>
          <div class="pl-herd" aria-label="Benötigte Tiere">
            <h4>Tiere für einen vollen Monat</h4>
            <% for (const h of herd) { %>
              <div class="r"><span class="fs-name"><%- icon(h.fill, h.name, 's') %><%= amt(h.need) %> <%= h.name %> pro Monat</span><span class="hint">braucht</span>
                <% h.options.slice(0, 3).forEach((o, i) => { %><%= i ? ' oder ' : '' %><span><b class="n"><%= de(o.n) %></b> <a href="/farming/wiki/tiere?tier=<%= encodeURIComponent(o.type) %>"><%= o.labels.length > 2 ? o.typeLabel : o.labels.join(' / ') %></a> <small class="hint">(je <%= amt(o.perMonth) %> pro Monat)</small></span><% }) %></div>
            <% } %>
            <p class="hint">Ausgewachsene Tiere bei voller Produktivität (gut gefüttert, Wasser<%= herd.some(h => /MANURE/.test(h.fill)) ? ', Stroh' : '' %> da). Mehr im <a href="/farming/wiki/tiere?tier=<%= encodeURIComponent(herd[0].options[0].type) %>">Wiki</a>.</p>
          </div>
        <% } %>

        <% if (rec.inputs.length || rec.cycles) { %>
          <% if (!form) { %>
            <a class="btn def pl-calcbtn" href="<%= link(sel, rec.id, '&rechnen=1') %>#rechner">Produktion rechnen</a>
          <% } else { %>
            <form method="get" action="/farming/produktion" class="fs-form pl-calc" id="rechner">
              <input type="hidden" name="g" value="<%= sel.key %>"><input type="hidden" name="p" value="<%= rec.id %>"><input type="hidden" name="rechnen" value="1">
              <h3>Produktion rechnen</h3>
              <% if (rec.inputs.length) { %>
                <p class="hint">Wie viel habt ihr von jedem Input? Der Rechner nimmt so viele Zyklen, wie das knappste Input zulässt.</p>
                <% rec.inputs.forEach((x, i) => { const have = sel.storage.find(s => s.fill === x.fill && s.level); %><label class="pl-inrow"><span class="fs-name"><%- icon(x.fill, x.name, 's') %><%= x.name %></span> <input name="in<%= i %>" type="number" min="0" step="any" value="<%= num(form.amounts[i] ?? (have && sel.section !== 'katalog' ? Math.round(have.level) : null)) %>" placeholder="<%= amt(x.amount * 10) %>"> <small>l / Stück<%= have && sel.section !== 'katalog' ? ' · im Lager ' + liters(have.level) : '' %></small></label><% }) %>
                <p class="hint pl-or">oder gewünschte Zyklen:</p>
              <% } %>
              <label class="pl-inrow"><span>Zyklen</span> <input name="zyklen" type="number" min="0" step="1" value="<%= num(form.cycles) %>" placeholder="<%= rec.cycles ? amt(rec.cycles) : '10' %>"></label>
              <% if (sel.mode === 'seriell') { %><label class="pl-inrow"><span>Gleichzeitig aktive Produktionen</span> <input name="gleich" type="number" min="1" max="99" step="1" value="<%= form.shared %>"></label><% } %>
              <div class="row"><button class="def">Rechnen</button> <a class="btn small" href="<%= link(sel, rec.id) %>">Schließen</a></div>
            </form>
            <% if (calc) { %>
              <div class="pl-result" role="status">
                <div class="pl-big"><b><%= de(calc.cycles) %></b> Zyklen</div>
                <% if (calc.made.length) { %><div class="pl-res"><small>Ergibt</small><%- calc.made.map(x => `<span class="pl-it big">${icon(x.fill, x.name, 's')}<b>${amt(x.total)}</b> ${escT(x.name)}</span>`).join('') %></div><% } %>
                <% if (calc.used.length) { %><div class="pl-res"><small>Verbraucht</small><%- calc.used.map(x => `<span class="pl-it">${icon(x.fill, x.name, 's')}${amt(x.need)} ${escT(x.name)}${x.left !== null ? ` <span class="hint">(übrig ${amt(x.left)})</span>` : ''}</span>`).join('') %></div><% } %>
                <% if (calc.months !== null) { %>
                  <div class="pl-res"><small>Dauer</small><span><b><%= de(calc.months, calc.months < 10 ? 1 : 0) %></b> <%= calc.months === 1 ? 'Monat' : 'Monate' %><%= dpp > 1 ? ' · ' + de(calc.days, calc.days < 10 ? 1 : 0) + ' Spieltage' : '' %><%= sel.mode === 'seriell' && form.shared > 1 ? ` (${form.shared} Produktionen teilen sich die Zyklen)` : '' %></span></div>
                  <% if (calc.cost !== null) { %><div class="pl-res"><small>Kosten</small><span><b><%= eur(calc.cost) %></b></span></div><% } %>
                <% } else { %><p class="hint">Für die Dauer fehlen die Zyklen pro Monat.</p><% } %>
              </div>
            <% } %>
          <% } %>
        <% } %>
      </div>
    <% } %>
    </div>
  </section>
  <% } %>
</div>
<%- include('_bottom') %>
