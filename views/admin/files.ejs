<%- include('../partials/head') %>
<% if (importMsg) { %><div class="msg">✔ <%= importMsg %></div><% } %>
<% if (disk) { %>
<p>💽 Speicher für Downloads: <b><%= fmtSize(disk.free) %></b> frei von <%= fmtSize(disk.total) %>
  <span class="sunken" style="display:inline-block;width:160px;height:12px;padding:0;vertical-align:middle"><span style="display:block;height:100%;background:#2a78d6;width:<%= ((1 - disk.free / disk.total) * 100).toFixed(1) %>%"></span></span>
  · <a href="/admin/downloads">📊 Download-Statistik</a></p>
<% } %>
<fieldset class="groupbox" id="eingang"><legend>📥 Große Dateien über die Netzwerkfreigabe</legend>
  <p>Für Dateien mit mehreren GB ist das schneller und zuverlässiger als der Browser: Kopiere sie im Heimnetz in den Ordner <code>eingang</code> im Download-Ordner (siehe Anleitung) und übernimm sie hier.</p>
  <% if (!imports.length) { %><p class="muted">Der Eingangsordner ist leer.</p><% } else { %>
  <form method="post" action="/admin/files/import">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <table class="list">
      <tr><th></th><th>Datei</th><th class="num">Größe</th><th>Status</th></tr>
      <% for (const f of imports) { %>
      <tr><td><input type="checkbox" name="names" value="<%= f.name %>" <%= f.ready ? 'checked' : 'disabled' %>></td><td><%= f.name %></td><td class="num"><%= fmtSize(f.size) %></td>
        <td><%= f.ready ? 'bereit' : '⏳ wird noch kopiert …' %></td></tr>
      <% } %>
    </table>
    <div class="row">
      <label>Kategorie:<select name="category" class="w100"><% for (const c of categories) { %><option><%= c %></option><% } %></select></label>
      <label>Spiel (optional):<input type="text" name="game" class="w100"></label>
    </div>
    <label>Beschreibung:<textarea name="description" style="min-height:40px"></textarea></label>
    <%- include('../partials/visibility', { item: { visibility: 'public' }, acl: [] }) %>
    <div class="actions"><button>📥 Ausgewählte übernehmen</button> <small>Titel und Details kannst du danach bei jeder Datei ändern.</small></div>
  </form>
  <% } %>
</fieldset>
<div class="actions" style="margin:6px 0 10px">
  <a class="btn" href="/files/upload"><b>📤 Hinzufügen</b></a>
  <a class="btn" href="/admin/files/kategorien">🏷️ Kategorien</a>
  <a class="btn" href="/files">📁 Downloads ansehen</a>
  <small class="muted">Im Fenster „Hinzufügen“ ziehst du Dateien hinein und wählst pro Datei Kategorie oder Mediaplayer. Gruppen als Sichtbarkeit stellst du danach bei der Datei ein.</small>
</div>
<table class="list">
  <tr><th>Titel</th><th>Kategorie / Spiel</th><th>Sichtbarkeit</th><th class="num">Größe</th><th class="num">⬇</th><th>Von</th><th></th></tr>
  <% for (const f of files) { %>
  <tr>
    <td><a href="/admin/files/<%= f.id %>"><b><%= f.title %></b></a><br><small><%= f.original_name %></small></td>
    <td><%= f.category %><%= f.game ? ' / ' + f.game : '' %></td>
    <td><%= f.visibility === 'friends' ? FRIENDS_LABEL : VISIBILITY[f.visibility] %></td>
    <td class="num"><%= fmtSize(f.size) %></td>
    <td class="num"><%= f.downloads %></td>
    <td><%= f.username || '–' %></td>
    <td><a href="/files/dl/<%= f.id %>">Download</a> · <a href="/admin/downloads/<%= f.id %>">Statistik</a></td>
  </tr>
  <% } %>
  <% if (!files.length) { %><tr><td colspan="7">Noch keine Dateien.</td></tr><% } %>
</table>
<%- include('../partials/foot') %>
