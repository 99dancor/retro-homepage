<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' – ' : '' %><%= site.title %></title>
<link rel="stylesheet" href="/static/retro.css">
<link rel="stylesheet" href="/theme.css">
<link rel="icon" href="/static/favicon.svg">
</head>
<body>
<% const isAdmin = path.startsWith('/admin') && typeof counts !== 'undefined'; %>
<div class="window<%= isAdmin || (typeof wide !== 'undefined' && wide) ? ' wide' : '' %>">
  <div class="titlebar">
    <span class="icon">💾</span>
    <span class="ttl"><%= isAdmin ? 'Systemsteuerung – ' : '' %><%= site.title %><%= title ? ' – ' + title : '' %></span>
    <a class="tb-btn" href="/" title="Startseite" aria-hidden="true">_</a><a class="tb-btn" href="#" aria-hidden="true">□</a><a class="tb-btn" href="/" title="Startseite" aria-hidden="true">×</a>
  </div>
  <% if (isAdmin) { %>
  <nav class="menubar admin-nav">
    <a href="/admin" class="<%= path === '/admin' || path === '/admin/' ? 'active' : '' %>">📊 Übersicht</a>
    <a href="/admin/posts" class="<%= path.startsWith('/admin/posts') ? 'active' : '' %>">📝 Blog</a>
    <a href="/admin/media" class="<%= path.startsWith('/admin/media') ? 'active' : '' %>">🖼️ Bilder</a>
    <a href="/admin/files" class="<%= path.startsWith('/admin/files') ? 'active' : '' %>">📁 Dateien</a>
    <a href="/admin/downloads" class="<%= path.startsWith('/admin/downloads') ? 'active' : '' %>">⬇ Downloads</a>
    <a href="/admin/mods" class="<%= path.startsWith('/admin/mods') ? 'active' : '' %>">🧩 Modlisten</a>
    <a href="/admin/links" class="<%= path.startsWith('/admin/links') ? 'active' : '' %>">🔗 Links</a>
    <a href="/admin/apps" class="<%= path.startsWith('/admin/apps') ? 'active' : '' %>">🎮 Apps</a>
    <a href="/admin/pages" class="<%= path.startsWith('/admin/pages') ? 'active' : '' %>">📄 Seiten</a>
    <a href="/admin/guestbook" class="<%= path.startsWith('/admin/guestbook') ? 'active' : '' %>">📖 Freundebuch<% if (counts.pending) { %> <span class="badge"><%= counts.pending %></span><% } %></a>
    <a href="/admin/messages" class="<%= path.startsWith('/admin/messages') ? 'active' : '' %>">✉️ Nachrichten<% if (counts.unread) { %> <span class="badge"><%= counts.unread %></span><% } %></a>
    <a href="/admin/users" class="<%= path.startsWith('/admin/users') ? 'active' : '' %>">👥 Nutzer</a>
    <a href="/admin/design" class="<%= path.startsWith('/admin/design') ? 'active' : '' %>">🎨 Design</a>
    <a href="/admin/settings" class="<%= path.startsWith('/admin/settings') ? 'active' : '' %>">⚙️ Einstellungen</a>
    <span class="spacer"></span>
    <a href="/">↩ Zur Website</a>
  </nav>
  <div class="body">
  <% if (typeof flash !== 'undefined' && flash) { %><div class="msg">✔ <%= flash %></div><% } %>
  <% } else { %>
  <nav class="menubar">
    <a href="/" class="<%= path === '/' ? 'active' : '' %>">Startseite</a>
    <% const navs = [['blog','/blog','Blog'],['files','/files','Downloads'],['mods','/mods','Modlisten'],['links','/links','Links'],['apps','/apps','Spiele & Apps'],['board','/forum','Forum'],['guestbook','/guestbook','Freundebuch'],['contact','/contact','Kontakt']]; %>
    <% for (const [key, href, label] of navs) {
         if (navHidden.includes(key)) continue;
         if (key === 'guestbook' && !guestbookEnabled) continue;
         if (key === 'board' && !boardEnabled) continue;
         if (key === 'contact' && !contactEnabled) continue; %>
      <a href="<%= href %>" class="<%= path.startsWith(href) ? 'active' : '' %>"><%= label %></a>
    <% } %>
    <% for (const p of navPages) { %><a href="/p/<%= p.slug %>" class="<%= path === '/p/' + p.slug ? 'active' : '' %>"><%= p.title %></a><% } %>
  </nav>
  <% if (marquee) { %><marquee scrollamount="4"><%= marquee %></marquee><% } %>
  <div class="body">
  <div class="layout">
  <main>
  <% } %>
