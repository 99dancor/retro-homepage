<%- include('partials/head') %>
<h1>🖼️ <%= a.title %></h1>
<p>von <a href="<%= profileUrl(a.byUser) %>"><%= a.by %></a><% if (painters.length) { %> mit <% painters.forEach((p, i) => { %><%= i ? ', ' : '' %><a href="<%= profileUrl(p.user) %>"><%= p.name %></a><% }) %><% } %> · <%= a.date %> · <%= a.w %> × <%= a.h %> Pixel · <%= size %>
  · <%= a.visibility === 'public' ? '🌐 öffentlich' : a.visibility === 'members' ? '👥 für Mitglieder' : '🔒 privat' %><%= a.pending ? ' (wartet auf Freigabe)' : '' %></p>
<div class="panel gal-full"><img src="/paint/bild/<%= a.id %>.png?v=<%= a.updated %>" alt="<%= a.title %>" width="<%= a.w %>" height="<%= a.h %>"></div>
<div class="actions">
  <a class="btn" href="/paint?bild=<%= a.id %>">🎨 In Paint öffnen</a>
  <a class="btn" href="/paint/bild/<%= a.id %>.png?download=1">⬇ Herunterladen (PNG)</a>
  <a href="/galerie">« Zur Galerie</a>
</div>
<% if (popupMsg) { %><div class="msg<%= popupMsg === 'ok' ? '' : ' err' %>"><%= popupMsg === 'ok' ? '💬 Danke! Dein Bild ist vorgeschlagen. Sobald es freigeschaltet ist, geht es ab und zu als Popup-Fenster auf.' : '⚠ ' + popupMsg %></div><% } %>
<% if (popup) { %>
<form method="post" action="/galerie/<%= a.id %>/popup" class="actions">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (popup.done) { %><button disabled>💬 Als Popup-Bild vorgeschlagen</button><% } else { %><button<%= popup.can ? '' : ' disabled' %>>💬 Als Popup-Bild vorschlagen</button><% } %>
  <small class="muted"><%= popup.done ? 'Ob es schon dabei ist, entscheidet der Admin.' : popup.can ? 'Lustige Bilder gehen ab und zu als kleines Fenster auf dem Desktop auf, wie früher die Werbefenster.' : 'Geht mit öffentlichen, freigegebenen Bildern.' %></small>
</form>
<% } %>
<% if (!a.mine) { %><p><small class="muted">In Paint malst du an einer Kopie weiter. Speichern legt sie unter deinen eigenen Bildern ab.</small></p><% } %>
<%- include('partials/foot') %>
