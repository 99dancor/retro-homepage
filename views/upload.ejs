<%- include('partials/head') %>
<%# Fenster „Hinzufügen“ (src/routes/public.js, public/upload.js). Ohne JavaScript schickt das Formular alle Dateien auf einmal in die Downloads. %>
<%
  const vis = folder ? 'private' : 'members';
  const visOpts = [['members', '👥 Alle angemeldeten Nutzer'], ['public', '🌐 Alle (öffentlich)'], ['friends', '⭐ Nur meine Freunde'], ['private', '🔒 Nur ich und der Admin']];
%>
<div class="tabs up-tabs" role="tablist">
  <button type="button" aria-selected="true">📤 Datei hochladen</button>
  <% if (user.isAdmin) { %><a class="btn" role="tab" href="/admin/files#eingang">📥 Netzwerkordner<%= imports ? ' (' + imports + ')' : '' %></a><% } %>
</div>
<div class="up-page">
<% if (msg) { %><div class="msg">✔ <%= msg %> <a href="/files">Zu den Downloads</a><% if (folder) { %> · <a href="/eigene-dateien?ordner=<%= folder.id %>">Zum Ordner „<%= folder.name %>“</a><% } %></div><% } %>
<% if (err) { %><div class="msg err">⚠ <%= err %></div><% } %>
<form method="post" action="/files/upload" enctype="multipart/form-data" id="up-form"
      data-cats="<%= JSON.stringify(cats.map(c => ({ name: c.name, icon: c.icon, ext: c.ext, game: c.game }))) %>"
      data-blocked="<%= blocked.join(' ') %>" data-music="<%= music ? JSON.stringify(music) : '' %>" data-max="<%= maxMb %>"
      data-preset="<%= preset %>" data-space="<%= space.limit ? space.free : '' %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (folder) { %><input type="hidden" name="ordner" value="<%= folder.id %>"><% } %>
  <div class="up-drop" data-drop>
    <b>Dateien hierher ziehen</b><br>
    oder <label class="btn small" style="display:inline-block;margin:4px 0 0">Durchsuchen…<input type="file" name="files" multiple required hidden data-pick></label>
    <br><small class="muted"><%= maxMb ? 'Höchstens ' + maxMb + ' MB pro Datei' : 'Keine Größengrenze' %><% if (space.limit) { %> · dein Speicher: <%= fmtSize(space.used) %> von <%= fmtSize(space.limit) %><% } %><% if (folder) { %> · landet im Ordner <b>📁 <%= folder.name %></b><% } %></small>
  </div>
  <table class="list up-list" data-list hidden>
    <thead><tr><th>Datei</th><th class="num">Größe</th><th>Landet in</th><th>Fortschritt</th><th></th></tr></thead>
    <tbody></tbody>
  </table>
  <div class="row" style="gap:10px;align-items:end;margin-top:8px">
    <label style="flex:1;min-width:160px">Wer darf es sehen?
      <select name="visibility" class="w100"><% for (const [k, l] of visOpts) { %><option value="<%= k %>"<%= k === vis ? ' selected' : '' %>><%= l %></option><% } %></select></label>
    <label style="flex:1;min-width:160px" data-gamebox>Spiel (bei Spielständen und Mods):
      <input type="text" name="game" class="w100" list="up-games" placeholder="z. B. Farming Simulator 25"></label>
    <datalist id="up-games"><% for (const g of games) { %><option value="<%= g %>"><% } %></datalist>
  </div>
  <noscript>
    <label>Kategorie:<select name="category"><% for (const c of cats) { %><option<%= c.name === preset ? ' selected' : '' %>><%= c.name %></option><% } %></select></label>
  </noscript>
  <label>Beschreibung (optional, für alle Dateien in den Downloads):<textarea name="description" style="min-height:44px"></textarea></label>
  <p class="muted"><small>Titel, Interpret und Album werden bei Musik aus der Datei gelesen. Ändern kannst du alles danach unter Eigenschaften.<% if (blocked.length) { %> Programme und Skripte (<%= blocked.slice(0, 6).map(e => '.' + e).join(', ') %> …) werden nicht angenommen.<% } %></small></p>
  <div class="up-foot"><span class="grow muted" data-sum></span><button type="submit" data-go><b>Hochladen</b></button><a class="btn" href="/files">Zu den Downloads</a></div>
</form>
</div>
<script src="<%= asset('upload.js') %>" defer></script>
<%- include('partials/foot') %>
