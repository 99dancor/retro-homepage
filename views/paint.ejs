<%- include('partials/head') %>
<%# Paint: Pixel-Rechnung in public/paint-core.js, Oberfläche in public/paint.js %>
<% const tools = [['free','Freihandauswahl'],['select','Auswahl'],['eraser','Radierer/Farbradierer'],['fill','Farbfüller'],['pick','Farbe auswählen'],['zoom','Lupe'],['pencil','Stift'],['brush','Pinsel'],['spray','Sprühdose'],['text','Text'],['line','Linie'],['curve','Kurve'],['rect','Rechteck'],['poly','Vieleck'],['ellipse','Ellipse'],['rrect','Abgerundetes Rechteck']]; %>
<div class="pt" id="paint" data-csrf="<%= csrf %>" data-site="<%= site.title %>" data-user="<%= user ? user.id : '' %>" data-username="<%= user ? user.username : '' %>"
     data-save="<%= canSave ? '1' : '' %>" data-gallery="<%= galleryOn ? '1' : '' %>" data-lobbies="<%= lobbiesOn ? '1' : '' %>" data-maxw="<%= maxW %>" data-maxh="<%= maxH %>">
  <div class="pt-menu" role="menubar"><span class="spacer"></span><span class="pt-doc" data-doc></span></div>
  <div class="pt-fontbar window" hidden>
    <div class="titlebar"><span class="ttl">Schriftarten</span></div>
    <div class="pt-fontrow">
      <select name="font" aria-label="Schriftart"><% for (const f of ['Arial','Times New Roman','Courier New','Comic Sans MS','Tahoma','Verdana','Georgia','Impact','Trebuchet MS']) { %><option><%= f %></option><% } %></select>
      <select name="size" aria-label="Schriftgröße"><% for (const s of [8,9,10,11,12,14,16,18,20,22,24,26,28,36,48,72]) { %><option value="<%= s %>"><%= s %></option><% } %></select>
      <button type="button" data-style="bold" title="Fett"><b>F</b></button><button type="button" data-style="italic" title="Kursiv"><i>K</i></button><button type="button" data-style="underline" title="Unterstrichen"><u>U</u></button>
    </div>
  </div>
  <div class="pt-main">
    <div class="pt-left">
      <div class="pt-tools" role="toolbar" aria-label="Werkzeuge">
        <% for (const [k, name] of tools) { %><button type="button" class="pt-tool" data-tool="<%= k %>" title="<%= name %>" aria-label="<%= name %>"><svg viewBox="0 0 16 16" aria-hidden="true"><use href="#pt-i-<%= k %>"/></svg></button><% } %>
      </div>
      <div class="pt-opts"></div>
    </div>
    <div class="pt-stage" tabindex="0" aria-label="Bild">
      <div class="pt-sheet">
        <canvas id="pt-canvas"></canvas>
        <canvas id="pt-remote" aria-hidden="true"></canvas>
        <canvas id="pt-overlay" aria-hidden="true"></canvas>
        <div class="pt-cursors" aria-hidden="true"></div>
        <div class="pt-grid" hidden></div>
        <div class="pt-selframe" hidden><% for (const d of ['nw','n','ne','w','e','sw','s','se']) { %><i class="pt-h" data-dir="<%= d %>"></i><% } %></div>
        <div class="pt-resize" hidden></div>
        <div class="pt-sizer"><% for (const d of ['nw','n','ne','w','e','sw','s','se']) { %><i class="pt-h<%= ['e','s','se'].includes(d) ? '' : ' hollow' %>" data-dir="<%= d %>"<%= ['e','s','se'].includes(d) ? ' data-live' : '' %>></i><% } %></div>
      </div>
    </div>
    <aside class="pt-side" hidden aria-label="Lobby">
      <div class="pt-side-head"><b data-lobby="name"></b><small data-lobby="info"></small>
        <div class="actions"><button type="button" class="small" data-lobby-act="link" title="Einladungslink">🔗 Einladen</button><button type="button" class="small" data-lobby-act="settings" title="Einstellungen der Lobby">⚙️</button><button type="button" class="small" data-lobby-act="leave">Verlassen</button></div></div>
      <ul class="pt-people" data-lobby="people"></ul>
      <div class="pt-chat" data-lobby="chat">
        <div class="pt-chat-log" data-lobby="log" aria-live="polite"></div>
        <form class="pt-chat-form" data-lobby="chatform"><input type="text" name="text" maxlength="300" placeholder="Nachricht …" aria-label="Nachricht an die Lobby" autocomplete="off"><button type="submit" class="small">Senden</button></form>
      </div>
    </aside>
  </div>
  <div class="pt-bottom">
    <button type="button" class="pt-cur" title="Vorder- und Hintergrundfarbe (antippen tauscht sie)"><i class="fg"></i><i class="bg"></i></button>
    <div class="pt-pal" aria-label="Farbpalette"></div>
    <span class="pt-pal-hint">Linksklick: Vordergrund · Rechtsklick: Hintergrund · Doppelklick: ändern</span>
  </div>
  <div class="statusbar pt-status"><span data-status="text"></span><span data-status="pos" class="pt-pos"></span><span data-status="size" class="pt-size"></span></div>
  <div class="pt-modal" hidden></div>
</div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="pt-i-free" viewBox="0 0 16 16"><path d="M3 3h5l2 3 3-1-1 5 2 3-6 1-3-2-2-4z" fill="none" stroke="#000" stroke-dasharray="1 1"/></symbol>
    <symbol id="pt-i-select" viewBox="0 0 16 16"><rect x="2.5" y="3.5" width="11" height="9" fill="none" stroke="#000" stroke-dasharray="2 1"/></symbol>
    <symbol id="pt-i-eraser" viewBox="0 0 16 16"><path d="M2 10l6-6 5 3-6 6z" fill="#ff8" stroke="#000"/><path d="M2 10l5 3v1l-5-3z" fill="#c8c"/></symbol>
    <symbol id="pt-i-fill" viewBox="0 0 16 16"><path d="M4 6l5-4 5 5-5 5z" fill="#fff" stroke="#000"/><path d="M4 6c-2 2-2 5-1 7" stroke="#008" fill="none" stroke-width="1.5"/><path d="M5 7h8" stroke="#000"/></symbol>
    <symbol id="pt-i-pick" viewBox="0 0 16 16"><path d="M3 13l7-7 2 2-7 7H3z" fill="#fff" stroke="#000"/><rect x="10" y="2" width="4" height="4" fill="#000" transform="rotate(45 12 4)"/></symbol>
    <symbol id="pt-i-zoom" viewBox="0 0 16 16"><circle cx="6.5" cy="6.5" r="4" fill="#cff" stroke="#000"/><path d="M9.5 9.5l5 5" stroke="#000" stroke-width="2"/></symbol>
    <symbol id="pt-i-pencil" viewBox="0 0 16 16"><path d="M3 13l1-3 8-8 2 2-8 8z" fill="#ff0" stroke="#000"/><path d="M3 13l1-3 2 2z" fill="#000"/></symbol>
    <symbol id="pt-i-brush" viewBox="0 0 16 16"><path d="M10 2h4l-5 7-2-1z" fill="#c80" stroke="#000"/><path d="M7 8l2 1c0 3-3 5-7 5 2-1 2-4 5-6z" fill="#00f" stroke="#000"/></symbol>
    <symbol id="pt-i-spray" viewBox="0 0 16 16"><rect x="8" y="5" width="5" height="9" fill="#ccc" stroke="#000"/><rect x="9" y="3" width="3" height="2" fill="#000"/><path d="M2 3h1M4 5h1M2 7h1M5 2h1M3 9h1M6 4h1" stroke="#00f"/></symbol>
    <symbol id="pt-i-text" viewBox="0 0 16 16"><text x="3" y="13" font-family="Times New Roman, serif" font-size="14" font-weight="bold">A</text></symbol>
    <symbol id="pt-i-line" viewBox="0 0 16 16"><path d="M2 13L14 3" stroke="#000"/></symbol>
    <symbol id="pt-i-curve" viewBox="0 0 16 16"><path d="M2 12C4 2 8 2 8 8s4 6 6-4" stroke="#000" fill="none"/></symbol>
    <symbol id="pt-i-rect" viewBox="0 0 16 16"><rect x="2.5" y="3.5" width="11" height="9" fill="none" stroke="#000"/></symbol>
    <symbol id="pt-i-poly" viewBox="0 0 16 16"><path d="M2.5 5.5l5-3 6 4-3 7h-6z" fill="none" stroke="#000"/></symbol>
    <symbol id="pt-i-ellipse" viewBox="0 0 16 16"><ellipse cx="8" cy="8" rx="6" ry="4.5" fill="none" stroke="#000"/></symbol>
    <symbol id="pt-i-rrect" viewBox="0 0 16 16"><rect x="2.5" y="3.5" width="11" height="9" rx="3" fill="none" stroke="#000"/></symbol>
  </defs>
</svg>
<script src="<%= asset('paint-core.js') %>"></script>
<script src="<%= asset('paint.js') %>"></script>
<% if (lobbiesOn && user) { %><script src="<%= asset('usermenu.js') %>"></script>
<script src="<%= asset('paint-lobby.js') %>"></script><% } %>
<%- include('partials/foot') %>
