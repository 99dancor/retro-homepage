<%- include('_head') %>
<%# Dancors Downloads (src/downloads.js): Projekte als Karten im Stil der Titelleiste einer Projektseite, darunter oder unter
    „Alle Dateien“ die Tabelle. Der Admin ordnet die Karten im Bearbeiten-Modus (public/v3-edit.js, public/downloads.js). %>
<% const fmt = t => t ? new Date(t * 1000).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
   const vno = v => String(v).replace(/^v/i, '');
   const link = (extra) => { const p = new URLSearchParams(); const all = { ort: node === 'projekte' || node === 'suche' ? '' : node, q, sort: sort === 'eigene' ? '' : sort, kat, nur, ...extra }; for (const [k, v] of Object.entries(all)) if (v) p.set(k, v); const s = p.toString(); return '/downloads' + (s ? '?' + s : ''); };
   const art = (r, cls) => `<span class="art ${cls || ''} c-${r.color || 'dl'}">${r.cover ? `<img src="${r.cover}" alt="">` : `<span class="emo" data-show="icon">${r.icon}</span>`}</span>`; %>
<% if (ok) { %><p class="v3-flash" role="status"><%= ok %></p><% } %>
<div<%= canArrange ? ' data-ed-root' : '' %>>
<div class="v3-page">
  <aside class="v3-side" aria-label="Kategorien">
    <nav class="grp nav">
      <a class="it<%= node === 'projekte' ? ' sel' : '' %>" href="/downloads<%= layout.start === 'projekte' ? '' : '?ort=projekte' %>"><span class="emo">⭐</span> Projekte<span class="n"><%= tree.projects %></span></a>
      <a class="it<%= node === 'alle' ? ' sel' : '' %>" href="/downloads<%= layout.start === 'alle' ? '' : '?ort=alle' %>"><span class="emo">🗂️</span> Alle Dateien<span class="n"><%= tree.all %></span></a>
      <% if (tree.fresh) { %><a class="it<%= node === 'neu' ? ' sel' : '' %>" href="/downloads?ort=neu"><span class="emo">🆕</span> Neu<span class="n"><%= tree.fresh %></span></a><% } %>
      <% if (tree.cats.length) { %><h3>Kategorien</h3><% } %>
      <% for (const c of tree.cats) { %>
      <a class="it<%= node === c.key ? ' sel' : '' %>" href="/downloads?ort=<%= encodeURIComponent(c.key) %>"><span class="emo"><%= c.icon %></span> <%= c.label %><span class="n"><%= c.n %></span></a>
      <% } %>
      <% if (tree.privat != null) { %>
      <h3>Nur für dich</h3>
      <a class="it<%= node === 'privat' ? ' sel' : '' %>" href="/downloads?ort=privat"><span class="emo">🔒</span> Privat<span class="n"><%= tree.privat %></span></a>
      <% } %>
    </nav>
    <% if (canUpload || canCreate || canSuggest) { %>
    <div class="grp" style="padding:12px;display:grid;gap:8px">
      <% if (canCreate) { %><a class="pill pri" href="/downloads/neues-projekt">＋ Neues Projekt</a><% } %>
      <% if (canUpload) { %><a class="pill" href="/files/upload">📤 Dateien hinzufügen</a><% } %>
      <% if (canSuggest) { %><a class="pill" href="/files/upload?tab=link">🔗 Link vorschlagen</a><% } %>
    </div>
    <% } %>
  </aside>

  <div class="v3-content">
    <% if (node === 'projekte') { %>
    <div class="dl-head">
      <h2 class="page-h" data-ed-text="title"><%= layout.title %></h2>
      <% if (isAdmin) { %><% if (canArrange) { %><button type="button" class="pill small" data-ed-start data-ed-off><span class="emo">✏️</span> Seite bearbeiten</button><% } else { %><a class="pill small" href="/downloads?ort=projekte&amp;bearbeiten" data-ed-off><span class="emo">✏️</span> Seite bearbeiten</a><% } %><% } %>
    </div>
    <p class="page-sub" data-ed-text="text" data-ed-multiline><%= layout.text %></p>
    <% } else { %>
    <h2 class="page-h"><%= heading %></h2>
    <p class="page-sub"><%= node === 'privat' ? 'Nur für Konten mit Freigabe für den Bereich Privat.' : node === 'alle' ? 'Projekte und einzelne Dateien in einer Liste, zum schnellen Suchen.' : `${cards.length + rows.length} ${cards.length + rows.length === 1 ? 'Eintrag' : 'Einträge'}` %></p>
    <% } %>

    <% if (canArrange) { %>
    <div class="card dl-opts" data-ed-only>
      <b>Startansicht:</b>
      <label class="check"><input type="radio" name="ed-start" value="projekte" data-ed-field="startP"<%= layout.start === 'projekte' ? ' checked' : '' %>> Projekte</label>
      <label class="check"><input type="radio" name="ed-start" value="alle" data-ed-field="startA"<%= layout.start === 'alle' ? ' checked' : '' %>> Alle Dateien</label>
      <b>Darstellung:</b>
      <label class="check"><input type="radio" name="ed-look" value="gross" data-ed-field="lookG"<%= layout.look === 'gross' ? ' checked' : '' %>> Groß</label>
      <label class="check"><input type="radio" name="ed-look" value="kompakt" data-ed-field="lookK"<%= layout.look === 'kompakt' ? ' checked' : '' %>> Kompakt</label>
      <label class="check"><input type="checkbox" data-ed-field="more"<%= layout.more ? ' checked' : '' %>> Hinweis auf einzelne Dateien zeigen</label>
    </div>
    <% } %>

    <form class="dl-bar" action="/downloads" role="search" data-ed-off>
      <% if (node !== 'projekte' && node !== 'suche') { %><input type="hidden" name="ort" value="<%= node %>"><% } %>
      <% if (sort !== 'eigene') { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
      <input type="search" name="q" value="<%= q %>" placeholder="In Downloads suchen …" aria-label="In Downloads suchen">
      <% if (q) { %><a class="pill small ghost" href="/downloads">✕ Suche löschen</a><% } %>
      <% if (node === 'projekte' && chips.length > 1) { %>
      <span class="chips" aria-label="Kategorie">
        <a class="chip<%= !kat ? ' on' : '' %>" href="<%= link({ kat: '' }) %>">Alle</a>
        <% for (const c of chips) { %><a class="chip<%= kat === c.name ? ' on' : '' %>" href="<%= link({ kat: c.name }) %>"><span class="emo"><%= c.icon %></span> <%= c.name %></a><% } %>
      </span>
      <% } %>
      <% if (node === 'alle') { %>
      <span class="chips"><a class="chip<%= !nur ? ' on' : '' %>" href="<%= link({ nur: '' }) %>">Alle</a><a class="chip<%= nur === 'projekte' ? ' on' : '' %>" href="<%= link({ nur: 'projekte' }) %>">⭐ Nur Projekte</a><a class="chip<%= nur === 'dateien' ? ' on' : '' %>" href="<%= link({ nur: 'dateien' }) %>">📄 Nur Dateien</a></span>
      <% } %>
      <span class="sp"></span>
      <% if (cards.length > 1) { %>
      <select data-go aria-label="Sortieren">
        <% for (const [k, label] of Object.entries(sorts)) { %><option value="<%= link({ sort: k === 'eigene' ? '' : k }) %>"<%= sort === k ? ' selected' : '' %>><%= label %></option><% } %>
      </select>
      <% } %>
      <% if (cards.length) { %>
      <span class="seg" aria-label="Darstellung"><a class="<%= look === 'gross' ? 'on' : '' %>" href="<%= link({ ansicht: 'gross' }) %>" aria-current="<%= look === 'gross' %>">▤ Groß</a><a class="<%= look === 'kompakt' ? 'on' : '' %>" href="<%= link({ ansicht: 'kompakt' }) %>" aria-current="<%= look === 'kompakt' %>">▦ Kompakt</a></span>
      <% } %>
    </form>

    <% if (cards.length) { %>
    <div class="pc-list<%= look === 'kompakt' ? ' compact' : '' %>"<%= canArrange ? ' data-ed-list=cards' : '' %>>
      <% for (const p of cards) { const isHub = p.type === 'link'; %>
      <article class="pc<%= isHub ? ' hub' : '' %>"<% if (canArrange) { %> data-ed-item data-key="<%= p.key %>" data-ed-val="<%= JSON.stringify(isHub ? { pin: false } : { pin: p.featured, icon: p.iconRaw, color: p.color, cover: p.cover || '' }) %>"<%= p.hidden ? ' data-hidden' : '' %><% } %>>
        <% if (canArrange) { %><span class="grip" data-ed-handle data-ed-only title="Ziehen" aria-hidden="true">⠿</span><% } %>
        <a class="art-l" href="<%= p.url %>" tabindex="-1" aria-hidden="true"><%- art(p) %></a>
        <div class="info">
          <h3><a href="<%= p.url %>"<%= isHub ? '' : ' data-ed-text=title' %>><%= p.title %></a><span class="flag">
            <span class="flag-b pin"<%= p.featured ? '' : ' hidden' %>>📌 Angepinnt</span>
            <% if (p.fresh) { %><span class="flag-b new">🆕 Neu</span><% } %>
            <% if (p.update) { %><span class="flag-b up">⬆ Update auf <%= vno(p.version) %></span><% } %>
          </span></h3>
          <% if (p.summary || canArrange) { %><p class="lead"<%= isHub ? '' : ' data-ed-text=summary data-ed-multiline' %>><%= p.summary %></p><% } %>
          <div class="cta">
            <% if (isHub) { %><a class="pill pri" href="<%= p.url %>">🚜 <%= p.version ? 'Version ' + vno(p.version) + ' im Hub' : 'Zum Hub' %></a>
            <% } else if (p.dl) { %><a class="pill pri" href="<%= p.dl %>">⬇ <%= p.version ? 'Version ' + vno(p.version) : 'Herunterladen' %> <small>(<%= p.sizeText %>)</small></a>
            <% } else { %><span class="muted">Noch keine Version.</span><% } %>
            <% if (p.count > 1) { %><a class="pill opt-c" href="<%= p.url %>#versionen"><%= p.count %> Versionen</a><% } %>
            <a class="pill opt-c" href="<%= p.url %>"><%= isHub ? 'Anleitung' : 'Details' %></a>
            <% if (p.edit && !isHub) { %><a class="pill opt-c" href="<%= p.url %>/bearbeiten">✎ Bearbeiten</a><% } %>
          </div>
          <div class="tags">
            <span class="tag"><%= p.catIcon %> <%= p.cat %></span>
            <% if (p.game) { %><span class="tag opt-c">🎮 <%= p.game %></span><% } %>
            <% if (!isHub) { %><span class="tag">⬇ <%= p.downloads %> Downloads</span><% } %>
            <% if (p.date) { %><span class="tag">Stand <%= fmt(p.date) %></span><% } %>
            <% if (p.vis && p.vis !== 'public') { %><span class="tag">🔒 <%= ({ members: 'Mitglieder', friends: 'Freunde', groups: 'Gruppen', private: 'privat' })[p.vis] %></span><% } %>
            <% if (p.owner) { %><span class="tag opt-c">von <%= p.owner %></span><% } %>
          </div>
          <% if (canArrange) { %>
          <div class="etools" data-ed-only>
            <% if (!isHub) { %><button type="button" class="pill small" data-pin><span class="pin-on">📌 Lösen</span><span class="pin-off">📌 Anpinnen</span></button><% } %>
            <button type="button" class="pill small" data-ed-up title="Nach oben">↑</button>
            <button type="button" class="pill small" data-ed-down title="Nach unten">↓</button>
            <button type="button" class="pill small" data-ed-hide><span class="h-on">🙈 Ausblenden</span><span class="h-off">👁️ Zeigen</span></button>
            <% if (!isHub) { %><button type="button" class="pill small" data-ed-props>🎨 Bild und Farbe</button><% } %>
          </div>
          <% } %>
        </div>
      </article>
      <% } %>
    </div>
    <% } %>

    <% if (node === 'projekte' && more && (layout.more || canArrange)) { %>
    <a class="more-card" href="/downloads?ort=alle"<%= layout.more ? '' : ' data-ed-only' %>>
      <span class="emo" aria-hidden="true">🗂️</span>
      <span><b>Außerdem <%= more %> <%= more === 1 ? 'einzelne Datei' : 'einzelne Dateien' %></b><small>Bilder, Dokumente und mehr ohne eigenes Projekt.</small></span>
      <span class="sp"></span><span class="pill">Alle Dateien ansehen →</span>
    </a>
    <% } %>

    <% if (rows.length) { %>
    <% if (cards.length) { %><h3 class="sec-h" style="margin-top:22px">Einzelne Dateien</h3><% } %>
    <div class="list" role="table" aria-label="Downloads">
      <div class="lr h" role="row"><span></span><span role="columnheader">Name</span><span role="columnheader" class="opt">Kategorie</span><span role="columnheader" class="opt">Größe</span><span role="columnheader" class="opt">Datum</span><span></span></div>
      <% for (const r of rows) { %>
      <div class="lr" role="row">
        <% if (r.type === 'project' || r.type === 'link') { %><span aria-hidden="true"><%- art(r, 'xs') %></span><% } else { %><span class="e emo" aria-hidden="true"><%= r.icon %></span><% } %>
        <span class="nm">
          <% if (r.type === 'project' || r.type === 'link') { %><a class="t" href="<%= r.url %>"><%= r.title %></a><% } else { %><b><%= r.title %></b><% } %>
          <span><% if (r.version) { %><span class="ver">v<%= vno(r.version) %></span> <% } %><%= r.type === 'project' ? 'Projekt' + (r.count > 1 ? ` · ${r.count} Versionen` : '') : r.summary || '' %></span>
        </span>
        <span class="mu opt"><%= r.cat %><% if (r.game) { %> · <%= r.game %><% } %></span>
        <span class="mu opt"><%= r.sizeText || '–' %></span>
        <span class="mu opt"><%= r.date ? fmt(r.date) : '' %></span>
        <span class="act">
          <% if (r.type === 'project') { %><a class="pill small" href="<%= r.url %>">Ansehen</a><% if (r.dl) { %><a class="pill small pri" href="<%= r.dl %>" aria-label="<%= r.title %> herunterladen">⬇</a><% } %>
          <% } else if (r.type === 'link') { %><a class="pill small pri" href="<%= r.url %>">Zum Hub</a>
          <% } else if (r.type === 'track') { %><a class="pill small" href="<%= r.url %>">▶ Abspielen</a><a class="pill small pri" href="<%= r.dl %>" aria-label="<%= r.title %> herunterladen">⬇</a>
          <% } else { %><% if (r.edit) { %><a class="pill small ghost" href="<%= r.edit %>" title="Bearbeiten">✎</a><% } %><a class="pill small pri" href="<%= r.dl %>">⬇ Download</a><% } %>
        </span>
      </div>
      <% } %>
    </div>
    <% } %>

    <% if (!cards.length && !rows.length) { %>
    <div class="list"><div class="empty-state"><span class="e emo">📭</span><%= q ? 'Nichts gefunden.' : 'Hier liegt noch nichts.' %></div></div>
    <% } %>
  </div>
</div>
</div>
<% if (editData) { %>
<script type="application/json" id="dl-edit"><%- JSON.stringify(editData).replace(/</g, '\\u003c') %></script>
<script src="<%= asset('v3-edit.js') %>" defer></script>
<% } %>
<script src="<%= asset('downloads.js') %>" defer></script>
<%- include('_foot') %>
