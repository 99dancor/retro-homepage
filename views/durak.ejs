<%- include('partials/head') %>
<%# Durak: Tische, Spiel und Statistik laufen in public/durak.js; gemischt und gegeben wird auf dem Server (src/durak.js) %>
<div class="bj pk dk" id="dk" data-csrf="<%= csrf %>" data-user="<%= user ? user.id : '' %>">
  <nav class="menubar bj-nav" role="tablist">
    <a href="#tische" data-view="tische">🎴 Tische</a><a href="#tisch" data-view="tisch" hidden>🟩 Mein Tisch</a><a href="#statistik" data-view="statistik">📊 Statistik</a><a href="#regeln" data-view="regeln">📜 Regeln</a>
    <span class="spacer"></span><span class="bj-me" id="dk-me"></span>
  </nav>
  <div class="bj-main" id="dk-main">
    <% if (!user) { %>
      <div class="bj-guest">
        <p class="bj-big">🎴 Durak</p>
        <p>Das russische Kartenspiel mit 36 Karten für 2 bis 6 Mitglieder an einem Tisch. Wer am Ende noch Karten hat, ist der Durak. Spiele, Siege und wie oft du Durak warst, landen in deinem Profil.</p>
        <p><a class="btn" href="/login?next=/durak">Anmelden</a><% if (registrationOpen) { %> <a class="btn" href="/register?next=/durak">Registrieren</a><% } %></p>
      </div>
    <% } %>
  </div>
  <div class="statusbar"><span id="dk-status">Klassischer Durak mit Zuwerfen.</span></div>
</div>
<dialog class="window mp-dlg" id="dk-dlg">
  <div class="titlebar"><span class="ttl" id="dk-dlg-title"></span></div>
  <form method="dialog" class="body">
    <div id="dk-dlg-body"></div>
    <div class="actions" id="dk-dlg-actions"></div>
  </form>
</dialog>
<% if (user) { %>
<script src="<%= asset('usermenu.js') %>"></script>
<script src="<%= asset('durak.js') %>"></script>
<% } %>
<%- include('partials/foot') %>
