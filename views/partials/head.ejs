<!DOCTYPE html>
<html lang="de" data-design="<%= siteDesign %>" data-mp-skin="<%= locals.playerSkin || 'klassisch' %>"<%= locals.user ? '' : ' data-mp-guest' %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% const isAdmin = path.startsWith('/admin') && typeof counts !== 'undefined'; %>
<title><%= isAdmin ? 'Seitenverwaltung – ' : '' %><%= title ? title + ' – ' : '' %><%= site.title %></title>
<link rel="stylesheet" href="<%= asset('retro.css') %>">
<link rel="stylesheet" href="/theme.css">
<link rel="icon" href="<%= asset('favicon.svg') %>">
<script type="application/json" id="darstellung-daten"><%- themes.clientData %></script>
<% if (path === '/farming' || path.startsWith('/farming/')) { %>
<%# Farming Hub: Aussehen schon im Kopf laden. Stand es erst im Body, zeigte jeder Klick kurz den Desktop-Hintergrund und das
    graue Fenster, bevor das dunkle Spielmenü kam (das „Blinken“ beim Wechseln der Reiter). %>
<link rel="stylesheet" href="<%= asset('fshub.css') %>">
<% } %>
<script src="<%= asset('display.js') %>"></script>
<script src="<%= asset('sound.js') %>"></script>
</head>
<% if (!isAdmin) { %>
<body class="embed" data-user="<%= user ? user.id : '' %>">
<div class="body">
<% } else if (embed) { %>
<%# Seitenverwaltung als Fenster auf dem Desktop: Baum links, rechts der Bereich mit Kopfzeile und „Einstellung suchen“ %>
<body class="embed admin" data-user="<%= user.id %>">
<div class="sv">
<%- include('admin-nav') %>
<div class="body admin-body sv-pane">
<%- include('admin-head') %>
<% if (typeof flash !== 'undefined' && flash) { %><div class="msg">✔ <%= flash %></div><% } %><% if (typeof fehler !== 'undefined' && fehler) { %><div class="msg err">⚠ <%= fehler %></div><% } %>
<% } else { %>
<body class="admin">
<div class="window wide">
  <div class="titlebar">
    <span class="icon">💾</span>
    <span class="ttl">Seitenverwaltung – <%= site.title %><%= title ? ' – ' + title : '' %></span>
    <a class="tb-btn" href="/" title="Zur Website" aria-hidden="true">_</a><a class="tb-btn" href="#" aria-hidden="true">□</a><a class="tb-btn" href="/" title="Zur Website" aria-hidden="true">×</a>
  </div>
  <div class="sv">
  <%- include('admin-nav') %>
  <div class="body sv-pane">
  <%- include('admin-head') %>
  <% if (typeof flash !== 'undefined' && flash) { %><div class="msg">✔ <%= flash %></div><% } %><% if (typeof fehler !== 'undefined' && fehler) { %><div class="msg err">⚠ <%= fehler %></div><% } %>
<% } %>
