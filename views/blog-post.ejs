<%- include('partials/head') %>
<p><a href="/blog">« Zurück zum Blog</a></p>
<article class="panel">
  <h1 style="margin-top:0"><%= post.title %></h1>
  <div class="meta"><small><%= fmtDate(post.created_at) %><% if (post.updated_at - post.created_at > 3600) { %> · aktualisiert <%= fmtDate(post.updated_at) %><% } %></small>
    <% if (!post.published) { %><span class="badge">Entwurf</span><% } %>
    <% for (const t of (post.tags || '').split(',').filter(Boolean)) { %><a class="tag" href="/blog?tag=<%= encodeURIComponent(t) %>">#<%= t %></a><% } %>
  </div>
  <hr>
  <div class="content"><%- bodyHtml %></div>
</article>
<% if (user && user.isAdmin) { %><p><a class="btn" href="/admin/posts/<%= post.id %>">✏️ Bearbeiten</a></p><% } %>
<%- include('partials/foot') %>
