<%- include('../partials/head') %>
<%# Farming Simulator Hub im Look des Spielmenüs: links eine Leiste mit Kacheln (Server, je Hof eine, unten Changelog und Vorschläge),
    rechts der Inhalt. Aussehen: public/fshub.css, Routen: src/routes/fshub.js %>
<link rel="stylesheet" href="<%= asset('fshub.css') %>">
<%- include('_icons') %>
<div class="fs fsg" id="fs" data-csrf="<%= csrf %>">
  <nav class="fs-rail" aria-label="Bereiche">
    <% const tile = (key, href, icon, label, extra, wrap) => `<a class="tile${section === key ? ' sel' : ''}${wrap ? ' wrap' : ''}" href="${href}"${section === key ? ' aria-current="page"' : ''}><svg aria-hidden="true"><use href="#i-${icon}"/></svg><span class="lbl">${label}</span>${extra || ''}</a>`; %>
    <%- tile('overview', '/farming', 'home', 'Übersicht') %>
    <%- tile('map', '/farming/karte', 'map', 'Karte') %>
    <%- tile('prices', '/farming/preise', 'chart', 'Preise') %>
    <%- tile('planner', '/farming/produktion', 'factory', 'Produktions&shy;planer', '', true) %>
    <%- tile('wiki', '/farming/wiki', 'book', 'Wiki') %>
    <%- tile('mods', '/farming/mods', 'puzzle', 'Mods', m.mods.length ? `<span class="cnt" style="background:var(--g-tile-hi)">${m.mods.length}</span>` : '') %>
    <span class="sep" aria-hidden="true"></span>
    <% for (const f of m.farms) { const on = section === 'farm' && locals.f && locals.f.id === f.id, ini = f.name.split(/\s+/).filter(w => /[\p{L}\d]/u.test(w)).slice(0, 2).map(w => [...w.replace(/^[^\p{L}\d]+/u, '')][0] || '').join('').toUpperCase() || '#'; %>
      <a class="tile<%= on ? ' sel' : '' %>" href="/farming/hof/<%= f.id %>" title="<%= f.name %>"<%= on ? ' aria-current=page' : '' %>>
        <span class="badge" style="--fc:<%= f.color %>" aria-hidden="true"><%= ini %></span><span class="lbl"><%= f.name %></span>
        <% if (myFarm === f.id) { %><span class="me" title="Dein Hof">★</span><% } %><% if (due.get(f.id)) { %><span class="cnt" title="heute fällig"><%= due.get(f.id) %></span><% } %>
      </a>
    <% } %>
    <span class="grow" aria-hidden="true"></span>
    <%- tile('changelog', '/farming/changelog', 'list', 'Changelog') %>
    <%- tile('ideas', '/farming/vorschlaege', 'bulb', 'Vorschläge') %>
    <% if (isAdmin) { %><a class="tile" href="/admin/farming" target="_top"><svg aria-hidden="true"><use href="#i-gear"/></svg><span class="lbl">Einstellungen</span></a><% } %>
  </nav>
  <main class="fs-main<%= locals.full ? ' full' : '' %><%= locals.bg ? ' has-bg' : '' %>"<% if (locals.bg) { %> style="--fs-bg:url('/farming/hintergrund.bild?v=<%= bg.v %>')"<% } %>>
    <% if (msg) { %><div class="msg">✔ <%= msg %></div><% } %>
    <% if (!m.configured && section !== 'changelog' && section !== 'ideas') { %>
      <div class="msg">Der Hub kennt den Server noch nicht. <% if (isAdmin) { %>Trag in der <a href="/admin/farming" target="_top">Seitenverwaltung → Farming</a> die Adressen aus dem Webinterface ein.<% } else { %>Ein Admin trägt die Adressen des Servers bald ein.<% } %></div>
    <% } %>
