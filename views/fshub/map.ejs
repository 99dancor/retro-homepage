<%- include('_top') %>
<%# Karte über das ganze Fenster: links die Ansichten wie im Spielmenü (◀ ▶ blättert, Linksklick blendet einen Eintrag aus, Rechtsklick zeigt nur ihn),
    rechts die Karte: Grundstücke als Umrisse aus dem Spiel, darüber je Eintrag ein Bild, was je Fleck wächst. Klick auf ein Grundstück,
    eine Station oder ein Fahrzeug zeigt alles dazu. Ohne JavaScript gehen Ansicht und Grundstückswahl über die Adresse. %>
<% const keys = Object.keys(LAYERS), li = keys.indexOf(layer), prevL = keys[(li + keys.length - 1) % keys.length], nextL = keys[(li + 1) % keys.length]; %>
<% const S = m.size || 2048, P = v => ((v + S / 2) / S * 1000).toFixed(1); %>
<div class="fs-title fs-maptitle">
  <h1>Karte<%= st && st.map ? ' · ' + st.map : '' %></h1>
  <% if (m.money !== null) { %><div class="fs-money">Kontostand: <b><%= eur(m.money) %></b></div><% } %>
</div>
<div class="fs-mapview">
  <aside class="fs-legend" id="fs-legend" aria-label="Ansichten der Karte">
    <div class="fs-pager">
      <a class="arr" href="/farming/karte?ansicht=<%= prevL %>" data-step="-1" aria-label="Vorige Ansicht">◀</a>
      <h2 id="fs-ltitle"><%= LAYERS[layer] %></h2>
      <a class="arr" href="/farming/karte?ansicht=<%= nextL %>" data-step="1" aria-label="Nächste Ansicht">▶</a>
    </div>
    <div class="fs-dots"><% keys.forEach(k => { %><a href="/farming/karte?ansicht=<%= k %>" data-layer="<%= k %>" title="<%= LAYERS[k] %>" aria-label="<%= LAYERS[k] %>"><i class="<%= k === layer ? 'on' : '' %>"></i></a><% }) %></div>
    <% for (const k of keys) { %>
      <div class="fs-items" data-group="<%= k %>" data-title="<%= LAYERS[k] %>"<%= k === layer ? '' : ' hidden' %>>
        <% for (const it of groups[k]) { %>
          <button type="button" class="fs-item" data-item="<%= it.key %>" title="Klick blendet aus, Rechtsklick zeigt nur diesen Eintrag">
            <span class="sw" style="background:<%= it.color %>"></span>
            <span class="lb"><% if (it.fill) { %><span class="fs-name"><%- icon(it.fill, it.label, 's') %><%= it.label %></span><% } else { %><%= it.label %><% } %></span>
            <span class="n"><%= it.ha ? ha(it.ha) : it.rows ? it.n + ' Reihen' : it.n || '' %></span>
          </button>
        <% } %>
        <% if (!groups[k].length) { %><p class="note">Nichts zu zeigen.</p><% } %>
        <% if (k === 'fruechte' && img.fruechte) { %><p class="note">Je Fleck aus dem letzten Autosave<%= ras.learned ? '. Welche Frucht welche ist, hat der Hub aus fields.xml gelernt.' : '.' %></p><% } %>
        <% if (k === 'boden' && img.boden) { %><p class="note">Je Fleck aus dem letzten Autosave, nur Ackerboden.</p><% } %>
        <% if (k === 'bodenart') { %><p class="note">Steht in keiner Datei des Spielstands. Admins tragen sie je Grundstück in der Infokarte ein. Farbe nach dem größten Anteil.</p><% } %>
        <% if ((k === 'fruechte' || k === 'wachstum' || k === 'boden') && !img[k] && !gs.some(f => f.source === 'auto')) { %><p class="note">Braucht den FTP-Zugang (Dichtekarten oder fields.xml).</p><% } %>
      </div>
    <% } %>
    <p class="note">Linksklick blendet ein oder aus · Rechtsklick: nur dieser Eintrag (noch mal: alle)</p>
    <div class="shows">
      <label class="inline"><input type="checkbox" data-show="nr" checked> Grundstücksnummern</label>
      <label class="inline"><input type="checkbox" data-show="veh"> Fahrzeuge</label>
      <label class="inline"><input type="checkbox" data-show="pal"> Paletten</label>
      <label class="inline"><input type="checkbox" data-show="orte" checked> Orte</label>
    </div>
    <% if (stations.length) { const placed = stations.filter(s => s.cx !== null); %>
      <div class="fs-stfilter">
        <h3>Stationen</h3>
        <% for (const [k, [l, c]] of Object.entries(STATION_CATS)) { const n = placed.filter(s => s.cat === k).length; if (!n) continue; %>
          <label class="inline"><input type="checkbox" data-show="st-<%= k %>" checked><span class="stsw" style="background:<%= c %>"><svg aria-hidden="true"><use href="#st-<%= k %>"/></svg></span><span class="lb"><%= l %></span><span class="n"><%= n %></span></label>
        <% } %>
        <% if (!placed.length) { %><p class="note">Wo die Stationen stehen, weiß der Hub erst mit der Mod „FS25 Hub Link“.</p><% } %>
      </div>
    <% } %>
    <% if (fit) { %>
      <details class="fs-fold" id="fs-fit" data-remember="fs-fold-fit">
        <summary>Kartenbild ausrichten <small>nur Admins</small></summary>
        <div class="in">
          <form method="post" action="/farming/karte/ausrichten" class="fs-form fs-fitform" data-fit-form><input type="hidden" name="_csrf" value="<%= csrf %>">
            <p class="note">Liegen die Grundstücke nicht genau auf dem Bild, hier schieben. Die Vorschau ändert sich sofort.</p>
            <label class="inline"><span class="lb">Größe</span><input type="range" min="50" max="200" step="0.1" value="<%= fit.scale %>" data-fit="scale" aria-label="Größe in Prozent"><input name="scale" type="number" min="50" max="200" step="0.1" value="<%= fit.scale %>" data-fit="scale"> %</label>
            <label class="inline"><span class="lb">Links / rechts</span><input type="range" min="-500" max="500" step="1" value="<%= fit.dx %>" data-fit="dx" aria-label="Verschiebung nach rechts in Metern"><input name="dx" type="number" min="-2000" max="2000" step="1" value="<%= fit.dx %>" data-fit="dx"> m</label>
            <label class="inline"><span class="lb">Oben / unten</span><input type="range" min="-500" max="500" step="1" value="<%= fit.dz %>" data-fit="dz" aria-label="Verschiebung nach unten in Metern"><input name="dz" type="number" min="-2000" max="2000" step="1" value="<%= fit.dz %>" data-fit="dz"> m</label>
            <div class="btns"><button class="btn small def">Ausrichtung speichern</button><button class="btn small" name="reset" value="1">Zurücksetzen</button></div>
          </form>
        </div>
      </details>
    <% } %>
  </aside>
  <div class="fs-mapbox" id="fs-mapbox">
    <svg class="fs-map" id="fs-map" viewBox="0 0 1000 1000" data-layer="<%= layer %>" role="img" aria-label="Karte mit Grundstücken"<%- hasImage ? ` data-size="${S}" data-base="${box.base}"` : '' %>>
      <defs>
        <%# Eigene Symbole im Stil der Hotspots im Spiel (keine Originalgrafiken) %>
        <symbol id="st-verkauf" viewBox="0 0 16 16"><path d="M8 2v7M4.8 6.2 8 9.4l3.2-3.2M3 10.5V13h10v-2.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="st-einkauf" viewBox="0 0 16 16"><path d="M8 9.4V2M4.8 5.2 8 2l3.2 3.2M3 10.5V13h10v-2.5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="st-produktion" viewBox="0 0 16 16"><path d="M2 14V7.5l3.5 2v-2l3.5 2v-2l2 1.2V2.5h2.5V14z" fill="#fff"/></symbol>
        <symbol id="st-tanken" viewBox="0 0 16 16"><path d="M3 14V3.2c0-.7.5-1.2 1.2-1.2h4.6c.7 0 1.2.5 1.2 1.2V14zm1.5-10v3h4V4z" fill="#fff" fill-rule="evenodd"/><path d="M10 7h1.5l1.5 1.5v4a1 1 0 0 1-2 0V10" fill="none" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/></symbol>
        <symbol id="st-haendler" viewBox="0 0 16 16"><path d="M2.5 6.5 3.6 3h8.8l1.1 3.5zM3.5 7.5h9V13h-3.2V9.5H6.7V13H3.5z" fill="#fff"/></symbol>
        <symbol id="st-sonstiges" viewBox="0 0 16 16"><path d="m8 2 1.8 4 4.2.4-3.2 2.8 1 4.2L8 11.2l-3.8 2.2 1-4.2L2 6.4l4.2-.4z" fill="#fff"/></symbol>
      </defs>
      <rect x="-5000" y="-5000" width="11000" height="11000" fill="#262c22"/>
      <rect width="1000" height="1000" fill="#4f6a33"/>
      <% if (hasImage) { %><image id="fs-mapimg" href="/farming/karte.bild?v=<%= mapV %>" x="<%= box.x %>" y="<%= box.y %>" width="<%= box.w %>" height="<%= box.w %>" preserveAspectRatio="none"/><% } %>
      <%# Was je Fleck wächst: ein Bild je Eintrag der Legende, Ansicht steht in data-of %>
      <g class="ras">
        <% for (const k of ['fruechte', 'wachstum', 'boden']) for (const it of groups[k].filter(x => x.image)) { %><% const bx = (ras.boxes && ras.boxes[it.image]) || [0, 0, 1000, 1000]; %><image href="/farming/karte/ebene/<%= it.image %>?v=<%= ras.at %>" x="<%= bx[0] %>" y="<%= bx[1] %>" width="<%= bx[2] %>" height="<%= bx[3] %>" preserveAspectRatio="none" data-of="<%= k %>" data-item="<%= it.key %>"<%- layer === k ? '' : ' style="display:none"' %>/><% } %>
      </g>
      <g class="plant"><% for (const o of m.orchards) { %><path d="<%= o.rows.map(r => `M${P(r[0])} ${P(r[1])}L${P(r[2])} ${P(r[3])}`).join('') %>" class="row-<%= o.type.toLowerCase() %>" data-of="fruechte" data-item="f:<%= o.type %>"><title><%= N.fill(o.type) %>-Plantage · <%= o.rows.length %> Reihen</title></path><% } %></g>
      <g class="flds">
        <% for (const g of gs) { const L = g.layer; %>
          <a href="/farming/karte?ansicht=<%= layer %>&amp;feld=<%= g.id %>" data-field="<%= g.id %>"><<%= g.d ? 'path' : 'circle' %> class="fld<%= sel && sel.id === g.id ? ' sel' : '' %>" <%- g.d ? `d="${g.d}"` : `cx="${g.cx}" cy="${g.cy}" r="${g.r}"` %>
            style="<%= keys.map(k => `--c-${k}:${L[k][1]}`).join(';') %>"
            <%- keys.map(k => `data-${k}="${L[k][0]}"`).join(' ') %>><title><%= fieldName(g) %> · <%= ha(g.area) %><%= g.farm ? ' · ' + g.farm.name : g.price ? ' · zu kaufen ' + eur(g.price) : '' %><%= g.crop ? ' · ' + g.crop : '' %></title></<%= g.d ? 'path' : 'circle' %>></a>
        <% } %>
      </g>
      <g class="nr"><% for (const g of gs) { %><g transform="translate(<%= g.cx %> <%= g.cy %>)"><g class="nc"><circle r="8"/><text><%= g.id %></text></g></g><% } %></g>
      <g class="orte"><% for (const p of m.places) { %><g><circle cx="<%= P(p.x) %>" cy="<%= P(p.z) %>" r="<%= Math.max(5, p.radius / S * 1000).toFixed(1) %>" class="ort"/><text x="<%= P(p.x) %>" y="<%= (Number(P(p.z)) - Math.max(6, p.radius / S * 1000) - 3).toFixed(1) %>" class="ort-t"><%= p.name %></text></g><% } %></g>
      <g class="stn"><% for (const s of stations.filter(s => s.cx !== null)) { %><a href="/farming/karte?station=<%= encodeURIComponent(s.uid) %>" data-station="<%= s.uid %>" class="st st-<%= s.cat %>" transform="translate(<%= s.cx %> <%= s.cy %>)"><g class="sc"><rect x="-9" y="-9" width="18" height="18" rx="3.5" fill="<%= STATION_CATS[s.cat][1] %>"/><use href="#st-<%= s.cat %>" x="-6.5" y="-6.5" width="13" height="13"/></g><title><%= s.name %> · <%= s.catLabel %></title></a><% } %></g>
      <g class="veh"><% for (const v of vehicles.filter(v => !v.pallet)) { %><a href="/farming/karte?fahrzeug=<%= v.i %>" data-vehicle="<%= v.i %>"><rect x="<%= (v.cx - 4).toFixed(1) %>" y="<%= (v.cy - 4).toFixed(1) %>" width="8" height="8" rx="1.5" fill="<%= v.driver || v.ai ? '#ffd400' : v.farm ? v.farm.color : '#fff' %>" stroke="#000"><title><%= v.name %><%= v.driver ? ' · ' + v.driver : v.ai ? ' · Helfer' : '' %></title></rect></a><% } %></g>
      <g class="pal"><% for (const v of vehicles.filter(v => v.pallet)) { %><a href="/farming/karte?fahrzeug=<%= v.i %>" data-vehicle="<%= v.i %>"><circle cx="<%= v.cx %>" cy="<%= v.cy %>" r="3" fill="#c8a165" stroke="#000"><title><%= v.name %> · <%= v.fill.map(x => x.name + ' ' + liters(x.amount)).join(', ') %></title></circle></a><% } %></g>
    </svg>
    <div class="fs-zoom">
      <button type="button" data-zoom="1.4" aria-label="Hineinzoomen" title="Hineinzoomen"><svg aria-hidden="true"><use href="#i-plus"/></svg></button>
      <button type="button" data-zoom="0.7" aria-label="Herauszoomen" title="Herauszoomen">−</button>
      <button type="button" data-zoom="0" aria-label="Ganze Karte" title="Ganze Karte"><svg aria-hidden="true"><use href="#i-fit"/></svg></button>
    </div>
    <div class="fs-maphint">Mausrad zoomt · Ziehen verschiebt · Klick auf Grundstück, Station oder Fahrzeug</div>
    <% if (!hasImage) { %><p class="fs-nomap">Kein Kartenbild. <%= isAdmin ? 'In der Seitenverwaltung die Map-Image-Adresse eintragen oder ein eigenes Bild hochladen.' : '' %></p><% } %>

    <div class="fs-finfo" id="fs-finfo"<%= sel ? '' : ' hidden' %>>
      <% if (sel) { %>
        <a class="x" href="/farming/karte?ansicht=<%= layer %>" data-close aria-label="Schließen">✕</a>
        <h2><%= fieldName(sel) %></h2>
        <div class="fs-rows">
          <div class="fs-row"><span class="t">Größe</span><span class="v"><%= ha(sel.area) %></span></div>
          <div class="fs-row"><span class="t">Besitzer</span><span class="v"><% if (sel.farm) { %><a href="/farming/hof/<%= sel.farm.id %>"><%= sel.farm.name %></a><% } else { %>zu kaufen für <%= eur(sel.price) %><% } %></span></div>
          <div class="fs-row"><span class="t">Frucht</span><span class="v"><%= sel.mix.length ? sel.mix.map(x => x.name + ' ' + ha(x.ha)).join(', ') : sel.crop || 'nichts' %></span></div>
          <div class="fs-row"><span class="t">Zustand</span><span class="v"><%= sel.states.length ? sel.states.map(x => x.label + ' ' + ha(x.ha)).join(', ') : sel.state ? N.STATES[sel.state][0] : 'unbekannt' %></span></div>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%# Für die Infokarten beim Klick: Daten je Grundstück, Station und Fahrzeug %>
<script type="application/json" id="fs-cards"><%- JSON.stringify(cards).replace(/</g, '\\u003c') %></script>
<script type="application/json" id="fs-stations"><%- JSON.stringify(stations).replace(/</g, '\\u003c') %></script>
<script type="application/json" id="fs-vehicles"><%- JSON.stringify(vehicles).replace(/</g, '\\u003c') %></script>
<script type="application/json" id="fs-pick"><%- JSON.stringify(pick).replace(/</g, '\\u003c') %></script>
<% if (isAdmin) { %>
<template id="fs-soilform">
  <details class="fs-fold"><summary>Bodenverteilung eintragen <small>nur Admins</small></summary>
    <form method="post" class="fs-form fs-soilform in"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <p class="note">Wie im Spiel unter Grundstücke (Prozent, leer lassen löscht)</p>
      <% for (const [k, l, c] of SOILS) { %><label class="inline"><span class="sw" style="background:<%= c %>"></span><span class="lb"><%= l %></span><input name="<%= k %>" type="number" min="0" max="100" step="any" data-soil="<%= k %>"> %</label><% } %>
      <label class="inline"><span class="lb">Ertragspotenzial</span><input name="yield" type="number" min="0" max="300" step="any" data-soil="yield"> %</label>
      <div class="btns"><button class="btn small def">Boden speichern</button></div>
    </form>
  </details>
</template>
<% } %>
<%- include('_bottom') %>
