<%- include('partials/head') %>
<%# Systemsteuerung für alle (src/routes/settings.js). Anzeige und Sounds öffnen die Fenster neben der Uhr (public/settings.js). %>
<% const section = (key, icon, label, href, extra) => ({ key, icon, label, href, extra }); %>
<div class="cpl" id="cpl" data-csrf="<%= csrf %>">
  <aside class="cpl-side">
    <h2>🛠️ Systemsteuerung</h2>
    <p><small><%= user ? 'Alles, was du für dich einstellst. Die Seite selbst verwaltet der Admin unter Seitenverwaltung.' : 'Ohne Konto bleibt alles in diesem Browser.' %></small></p>
    <% if (page !== 'start') { %><p><a href="/einstellungen">⬅ Zur Übersicht</a></p><% } %>
  </aside>
  <div class="cpl-main">
  <% if (page === 'start') { %>
    <div class="cpl-grid">
      <button type="button" class="cpl-item" data-panel="displaybtn"><span>🖥️</span><b>Anzeige</b><small>Windows 98 oder XP, Farben, Hintergrund, Größe der Oberfläche</small></button>
      <% if (user) { %>
        <a class="cpl-item" href="/einstellungen/desktop"><span>🗂️</span><b>Desktop und Taskleiste</b><small>readme.txt, Standardsymbole, Lobby-Widget, Suche</small></a>
        <a class="cpl-item" href="/einstellungen/speicher"><span>💽</span><b>Speicherplatz</b><small>Belegt und frei, Papierkorb</small></a>
      <% } %>
      <% if (user) { %>
        <a class="cpl-item" href="/konto"><span>🔑</span><b>Konto und Passwort</b><small>Profil, Privatsphäre, Statistik, Benachrichtigungen, Kennwort, Spielstände</small></a>
      <% } %>
      <button type="button" class="cpl-item" data-panel="volumebtn"><span>🔊</span><b>Sounds</b><small>Lautstärke von Musik und Effekten<% if (user) { %>; Messenger-Töne unter Konto und Passwort<% } %></small></button>
      <a class="cpl-item" href="/datenschutz"><span>🔒</span><b>Datenschutz</b><small>Was die Seite speichert und warum</small></a>
      <% if (!user) { %><a class="cpl-item" href="/login?next=/einstellungen"><span>👤</span><b>Anmelden</b><small>Mit Konto gibt es eigene Ordner, Textdokumente und mehr</small></a><% } %>
    </div>
    <% if (user && user.isAdmin) { %>
    <h3 class="cpl-h">Verwaltung</h3>
    <div class="cpl-grid">
      <a class="cpl-item" href="/admin"><span>⚙️</span><b>Seitenverwaltung</b><small>Inhalte, Mitglieder, Design und Einstellungen der Seite</small></a>
      <a class="cpl-item" href="/admin/desktop"><span>🖥️</span><b>Desktop für alle</b><small>readme.txt, Standardsymbole, Grenzen, Speicher</small></a>
    </div>
    <% } %>

  <% } else if (page === 'desktop') { %>
    <h1>🗂️ Desktop und Taskleiste</h1>
    <% if (saved) { %><div class="msg">✔ Gespeichert. Der Desktop zeigt es beim nächsten Laden.</div><% } %>
    <form method="post" action="/einstellungen/desktop" data-desk-refresh>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <fieldset class="groupbox"><legend>Symbole, die jeder hat</legend>
        <p><small>Was du ausblendest, liegt nur bei dir nicht mehr auf dem Desktop.</small></p>
        <% for (const i of icons) { %><label class="inline"><input type="checkbox" name="icon" value="<%= i.key %>"<%= d.hidden.includes(i.key) ? '' : ' checked' %>> <%= i.icon %> <%= i.name %></label><% } %>
      </fieldset>
      <fieldset class="groupbox"><legend>Symbole anordnen</legend>
        <label class="inline"><input type="radio" name="arrange" value="frei"<%= d.arrange === 'frei' ? ' checked' : '' %>> Frei (wohin du sie ziehst)</label>
        <label class="inline"><input type="radio" name="arrange" value="name"<%= d.arrange === 'name' ? ' checked' : '' %>> Automatisch nach Name</label>
        <label class="inline"><input type="radio" name="arrange" value="typ"<%= d.arrange === 'typ' ? ' checked' : '' %>> Automatisch nach Art</label>
      </fieldset>
      <fieldset class="groupbox"><legend>Widgets und Taskleiste</legend>
        <% if (lobbyOn) { %><label class="inline"><input type="checkbox" name="lobbies" value="1"<%= d.lobbies ? ' checked' : '' %>> „Offene Lobbys“ auf dem Desktop zeigen</label><br><% } else { %><input type="hidden" name="lobbies" value="<%= d.lobbies ? '1' : '' %>"><% } %>
        <% if (searchOn) { %><label class="inline"><input type="checkbox" name="search" value="1"<%= d.search ? ' checked' : '' %>> Suchfeld in der Taskleiste (Strg+K)</label><% } else { %><input type="hidden" name="search" value="<%= d.search ? '1' : '' %>"><% } %>
        <p><small>Besucherzähler und Buttons blendest du unter 🖥️ Anzeige → Effekte aus.</small></p>
      </fieldset>
      <div class="actions"><button>Speichern</button></div>
    </form>
    <fieldset class="groupbox"><legend>Deine Grenzen</legend>
      <table class="kv">
        <tr><td>Ordner</td><td class="num"><%= counts.folders %> von <%= limits.folders %></td></tr>
        <tr><td>Textdokumente</td><td class="num"><%= counts.texts %> von <%= limits.texts %> (je bis <%= limits.chars.toLocaleString('de-DE') %> Zeichen)</td></tr>
        <tr><td>Verknüpfungen und Internetlinks</td><td class="num"><%= counts.links %> von <%= limits.links %></td></tr>
        <tr><td>Papierkorb</td><td class="num">löscht nach <%= limits.trashDays %> Tagen</td></tr>
      </table>
    </fieldset>

  <% } else if (page === 'speicher') { %>
    <h1>💽 Speicherplatz</h1>
    <% const COLORS = ['#2a78d6', '#eb6834', '#1f9e5a', '#c6409a', '#8a63d2']; let at = 0; const total = space.limit || Math.max(space.used, 1);
       const stops = space.parts.map((p, i) => { const from = at; at += p.bytes / total * 100; return `${COLORS[i % COLORS.length]} ${from.toFixed(2)}% ${at.toFixed(2)}%`; }); %>
    <div class="drive">
      <div class="drive-pie" role="img" aria-label="<%= space.limit ? space.pct + ' Prozent belegt' : 'Belegt: ' + fmtSize(space.used) %>" style="background: conic-gradient(<%= stops.concat([`#f4f4f4 ${at.toFixed(2)}% 100%`]).join(', ') %>)"></div>
      <table class="kv drive-legend">
        <% space.parts.forEach((p, i) => { %><tr><td><i class="drive-key" style="background:<%= COLORS[i % COLORS.length] %>"></i><%= p.label %></td><td class="num"><%= fmtSize(p.bytes) %></td></tr><% }) %>
        <tr class="drive-sum"><td><b>Belegt</b></td><td class="num"><b><%= fmtSize(space.used) %></b></td></tr>
        <% if (space.limit) { %><tr><td><i class="drive-key free"></i>Frei</td><td class="num"><%= fmtSize(space.free) %></td></tr><tr><td>Speicher insgesamt</td><td class="num"><%= fmtSize(space.limit) %></td></tr><% } else { %><tr><td colspan="2"><small>Ohne Grenze.</small></td></tr><% } %>
      </table>
    </div>
    <p><small>Ein Speicher für alles: Downloads, Mediaplayer, Paint-Bilder, Bilder in Beiträgen und Textdokumente. Was im Papierkorb liegt, zählt mit, bis es nach <%= limits.trashDays %> Tagen von selbst verschwindet.</small></p>
    <div class="actions"><a class="btn" href="/eigene-dateien">🗂️ Eigene Dateien</a><a class="btn" href="/eigene-dateien?ordner=papierkorb">🗑️ Papierkorb (<%= trashN %>)</a></div>
  <% } %>
  </div>
</div>
<script src="<%= asset('settings.js') %>"></script>
<%- include('partials/foot') %>
