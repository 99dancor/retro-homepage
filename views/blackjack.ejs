<%- include('partials/head') %>
<%# Blackjack: Tische, Spiel und Statistik laufen in public/blackjack.js; gemischt und gegeben wird auf dem Server (src/blackjack.js) %>
<div class="bj" id="bj" data-csrf="<%= csrf %>" data-user="<%= user ? user.id : '' %>">
  <nav class="menubar bj-nav" role="tablist">
    <a href="#tische" data-view="tische">🃏 Tische</a><a href="#tisch" data-view="tisch" hidden>🟩 Mein Tisch</a><a href="#statistik" data-view="statistik">📊 Statistik</a><a href="#regeln" data-view="regeln">📜 Regeln</a>
    <span class="spacer"></span><span class="bj-me" id="bj-me"></span>
  </nav>
  <div class="bj-main" id="bj-main">
    <% if (!user) { %>
      <div class="bj-guest">
        <p class="bj-big">🃏 Blackjack</p>
        <p>Spiel mit anderen Mitgliedern an einem Tisch. Jeder startet mit <b><%= rules.buyin.toLocaleString('de-DE') %> €</b> Spielgeld; Bilanz und Statistik landen in deinem Profil.</p>
        <p><a class="btn" href="/login?next=/blackjack">Anmelden</a><% if (registrationOpen) { %> <a class="btn" href="/register?next=/blackjack">Registrieren</a><% } %></p>
      </div>
    <% } %>
  </div>
  <div class="statusbar"><span id="bj-status">Spielgeld, kein echtes Geld.</span></div>
</div>
<dialog class="window mp-dlg" id="bj-dlg">
  <div class="titlebar"><span class="ttl" id="bj-dlg-title"></span></div>
  <form method="dialog" class="body">
    <div id="bj-dlg-body"></div>
    <div class="actions" id="bj-dlg-actions"></div>
  </form>
</dialog>
<% if (user) { %>
<script src="<%= asset('usermenu.js') %>"></script>
<script src="<%= asset('blackjack.js') %>"></script>
<% } %>
<%- include('partials/foot') %>
