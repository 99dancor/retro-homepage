<%- include('partials/head') %>
<%# UNO, Flip 7 und Pilli Pilli: Tische, Spiel und Statistik laufen in public/cardtable.js plus dem Skript des Spiels; gemischt und gegeben wird auf dem Server (src/cardtable.js) %>
<div class="bj pk dk cg cg-<%= game.id %>" id="cg" data-csrf="<%= csrf %>" data-user="<%= user ? user.id : '' %>" data-game="<%= game.id %>" data-title="<%= game.name %>" data-icon="<%= game.icon %>" data-seats="<%= game.minSeats %>-<%= game.maxSeats %>">
  <nav class="menubar bj-nav" role="tablist">
    <a href="#tische" data-view="tische"><%= game.icon %> Tische</a><a href="#tisch" data-view="tisch" hidden>🟩 Mein Tisch</a><a href="#statistik" data-view="statistik">📊 Statistik</a><a href="#regeln" data-view="regeln">📜 Regeln</a>
    <span class="spacer"></span><span class="bj-me" id="cg-me"></span>
  </nav>
  <div class="bj-main" id="cg-main">
    <% if (!user) { %>
      <div class="bj-guest">
        <p class="bj-big"><%= game.icon %> <%= game.name %></p>
        <p><%= game.intro %></p>
        <p><a class="btn" href="/login?next=/<%= game.id %>">Anmelden</a><% if (registrationOpen) { %> <a class="btn" href="/register?next=/<%= game.id %>">Registrieren</a><% } %></p>
      </div>
    <% } %>
  </div>
  <div class="statusbar"><span id="cg-status"><%= game.name %> für <%= game.minSeats %> bis <%= game.maxSeats %> Spieler.</span></div>
</div>
<dialog class="window mp-dlg" id="cg-dlg">
  <div class="titlebar"><span class="ttl" id="cg-dlg-title"></span></div>
  <form method="dialog" class="body">
    <div id="cg-dlg-body"></div>
    <div class="actions" id="cg-dlg-actions"></div>
  </form>
</dialog>
<% if (user) { %>
<script src="<%= asset('usermenu.js') %>"></script>
<script src="<%= asset('cardtable.js') %>"></script>
<script src="<%= asset(game.script) %>"></script>
<% } %>
<%- include('partials/foot') %>
