<div class="startmenu" id="startmenu" data-title="<%= site.title %>">
  <a href="/">🏠 Startseite</a>
  <%# Einträge aus src/programs.js: [Schlüssel, Adresse, Beschriftung] oder [Gruppe, Beschriftung, [Einträge]] → Untermenü wie bei Windows 98, auch verschachtelt.
      Jeden Eintrag kann man auf den Desktop ziehen, dann entsteht dort eine Verknüpfung (public/desk.js). %>
  <% const entries = programs.menu(user);
     const off = programs.off({ guestbookEnabled, boardEnabled, cardsEnabled, paintEnabled, quizEnabled, werwolfEnabled, galleryEnabled, contactEnabled, farmingVisible });
     const shown = ([key, , b]) => Array.isArray(b) ? b.some(shown) : !(navHidden.includes(key) || off[key]);
     function menu(list) { for (const [key, a, b] of list.filter(shown)) {
       if (Array.isArray(b)) { %>
    <div class="sub"><button type="button" class="menu-item sub-toggle" aria-expanded="false"><%- programs.labelHtml(a) %></button><div class="submenu"><% menu(b) %></div></div>
  <% } else { %>
    <a href="<%= a %>"><%- programs.labelHtml(b) %></a>
  <% } } }
     menu(entries); %>
  <% for (const p of navPages) { if (p.slug === 'regeln') continue; %><a href="/p/<%= p.slug %>">📄 <%= p.title %></a><% } %>
  <hr>
  <a href="/einstellungen">🛠️ Systemsteuerung</a>
  <% if (user && user.isAdmin) { %><a href="/admin">⚙️ Seitenverwaltung</a><% } %>
  <%# Info: Regeln, Changelog und Datenschutz unten im Startmenü %>
  <div class="sub"><button type="button" class="menu-item sub-toggle" aria-expanded="false">ℹ️ Info</button><div class="submenu">
    <% if (rulesPage) { %><a href="/p/regeln">📜 Regeln</a><% } %>
    <a href="/changelog">📋 Changelog</a>
    <a href="/datenschutz">🔒 Datenschutz</a>
  </div></div>
  <% if (user) { %>
    <div class="sub"><button type="button" class="menu-item sub-toggle" aria-expanded="false">👤 Mein Konto</button><div class="submenu">
      <a href="<%= profileUrl(user.username) %>">👤 Mein Profil</a>
      <a href="/konto">🔑 Konto und Passwort</a>
    </div></div>
    <hr>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="menu-item">🚪 <%= user.name %> abmelden…</button></form>
  <% } else { %>
    <hr>
    <a href="/login">🔑 Anmelden…</a>
    <% if (registrationOpen) { %><a href="/register">✏️ Registrieren…</a><% } %>
  <% } %>
</div>
<div class="taskbar">
  <button class="start" id="startbtn" aria-expanded="false" aria-controls="startmenu"><span class="start-logo" aria-hidden="true">🪟</span> <span class="start-text">Start</span></button>
  <span class="grip" aria-hidden="true"></span>
  <%# Suche (Strg+K), Logik in public/desk.js. Abschaltbar in der Seitenverwaltung und pro Mitglied in der Systemsteuerung %>
  <% if (typeof desk !== 'undefined' && desk.search) { %>
  <div class="tb-search" id="tbsearch" role="search">
    <button type="button" class="tb-search-btn" title="Suchen (Strg+K)" aria-label="Suchen">🔍</button>
    <input type="search" id="tbsearch-q" placeholder="Suchen…" aria-label="Suchen (Strg+K)" autocomplete="off" spellcheck="false" aria-controls="searchpop" aria-expanded="false" maxlength="100">
  </div>
  <% } %>
  <div class="tasks" id="tasks"><% if (typeof shellTask !== 'undefined') { %><span class="task"><%= shellTask %></span><% } %></div>
  <div class="tray">
    <%# Messenger neben der Uhr: eigener Status und ungelesene Nachrichten, Logik in public/messenger-hub.js %>
    <% if (user) { %><a class="tray-btn msgr-tray<%= unreadPm ? ' msgr-new' : '' %>" id="msgrtray" href="/messenger" title="Messenger" aria-label="Messenger"><i class="st st-offline"></i><span class="pm-count"<%= unreadPm ? '' : ' hidden' %>><%= unreadPm %></span></a><% } %>
    <% if (user) { %><button type="button" class="tray-btn notify-btn" id="notifybtn" title="Benachrichtigungen" aria-label="Benachrichtigungen" aria-expanded="false" aria-controls="notifypanel">🔔<span class="notify-count"<%= unreadNotify ? '' : ' hidden' %>><%= unreadNotify %></span></button><% } %>
    <button type="button" class="tray-btn" id="displaybtn" title="Darstellung anpassen" aria-label="Darstellung anpassen" aria-expanded="false" aria-controls="displaypanel">🖥️</button>
    <button type="button" class="tray-btn" id="volumebtn" title="Lautstärke" aria-label="Lautstärke" aria-expanded="false" aria-controls="volumepanel">🔊</button>
    <span id="clock"></span>
  </div>
</div>
<% if (typeof desk !== 'undefined' && desk.search) { %>
<div class="window search-pop" id="searchpop" role="dialog" aria-label="Suchergebnisse" hidden>
  <div class="body"><div class="res" id="searchres" role="listbox" aria-label="Treffer"></div>
    <div class="res-foot"><a href="/suche" data-all>🔍 Alle Ergebnisse anzeigen</a><small>Findet nur, was du auch öffnen darfst.</small></div></div>
</div>
<% } %>
<%- include('display-panel') %>
<% if (user) { %>
<%# Benachrichtigungen: öffnet sich über die 🔔 neben der Uhr, Logik in public/notify.js %>
<div class="window notify-panel" id="notifypanel" role="dialog" aria-label="Benachrichtigungen" hidden data-csrf="<%= csrf %>">
  <div class="titlebar"><span class="ttl">🔔 Benachrichtigungen</span></div>
  <div class="body">
    <div class="notify-list sunken" id="notifylist"><p class="muted">Lade …</p></div>
    <div class="actions"><button type="button" class="small" data-nact="read">✔ Alle gelesen</button><a class="btn small" href="/benachrichtigungen">Alle anzeigen</a><a class="btn small" href="/konto?reiter=benachrichtigungen#benachrichtigungen" title="Einstellungen">⚙️</a></div>
  </div>
</div>
<% } %>
<%# Lautstärke: öffnet sich über den 🔊-Knopf neben der Uhr, Logik in public/sound.js %>
<div class="window volume-panel" id="volumepanel" role="dialog" aria-label="Lautstärke" hidden>
  <div class="titlebar"><span class="ttl">🔊 Lautstärke</span></div>
  <div class="body">
    <div class="vol-cols">
      <label class="vol-col"><span>Musik</span><input type="range" class="vertical" name="musik" min="0" max="100" aria-label="Lautstärke Musik"><output></output></label>
      <label class="vol-col"><span>Effekte</span><input type="range" class="vertical" name="effekte" min="0" max="100" aria-label="Lautstärke Effekte"><output></output></label>
    </div>
    <label class="inline"><input type="checkbox" name="stumm"> Ton aus</label>
  </div>
</div>
